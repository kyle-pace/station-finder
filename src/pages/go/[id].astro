---
// One short link per station for marketing: /go/<station>/ (newsletters, social posts,
// QR codes, ads). It never jumps straight to an app store; it opens a page where the
// phone's own "Get the app" banner can offer the station's app:
//   - phone or tablet: the station's web app if it has one (station web apps carry
//     Apple's and Google's app banners), otherwise its page on this site (which does too)
//   - computer: the station's web app, else its website, else its page here
// Never the national PBS or NPR site. Same for every station. Nothing is recorded: the
// choice happens in the browser.
//
// Show-level links (/go/<station>/?show=<id>) wait until station web apps have stable show
// URLs (planned as watch.<station>/show/:id).
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { organizations, verbFor, host, type Organization } from '../../lib/data';
import { url } from '../../lib/site';

export function getStaticPaths() {
  return organizations.map((org) => ({ params: { id: org.id }, props: { org } }));
}

const { org } = Astro.props as { org: Organization };
const own = (p: string) => org.apps.find((a) => a.platform === p && !a.extra && a.kind !== 'instructions')?.url;
const stationPage = url(`/station/${org.id}/`);
// The browser destination: the station's web app, else its website, else its page here.
const webApp = own('web');
const browser = webApp ?? org.website ?? stationPage;
const browserLabel = webApp ? `${verbFor(org.mediaTypes)} in your browser` : org.website ? `Visit ${org.name}'s website` : `See every way to watch and listen`;
const targets = { phone: webApp ?? stationPage, computer: browser };
---

<Base title={org.name} description={`Get ${org.name} on your phone, tablet, TV, or computer.`} noindex ogImage={`/og/${org.id}.png`}>
  <div class="wrap narrow band go" data-go={JSON.stringify(targets)} data-name={org.name}>
    <p class="eyebrow">{org.name}</p>
    <h1 data-go-title>Choose where to go</h1>
    <p class="muted" data-go-sub>Pick the option for the device you're on.</p>
    <div class="stack gap-12 go-options">
      <a class="btn btn-secondary btn-lg" href={browser} rel="noopener" data-go-browser><Icon name="web" /><span>{browserLabel}</span>{browser !== stationPage && <span class="small muted go-host">{host(browser)}</span>}</a>
    </div>
    <p class="small"><a href={stationPage}>See every way to get {org.name} →</a></p>
  </div>
</Base>

<script>
  // Phones and tablets go to a page with the "Get the app" banner; computers to the
  // station's site. Without JavaScript, the links on the page do the same job.
  import { detectDevice } from '../../scripts/device-detect';

  const root = document.querySelector<HTMLElement>('[data-go]');
  if (root) {
    const t = JSON.parse(root.dataset.go!) as { phone: string; computer: string };
    root.querySelector('[data-go-title]')!.textContent = `Taking you to ${root.dataset.name}…`;
    root.querySelector('[data-go-sub]')!.textContent = '';
    location.replace(detectDevice() === 'desktop' ? t.computer : t.phone);
  }
</script>

<style>
  .go { padding-block: var(--space-64); }
  .go-options .btn { justify-content: flex-start; flex-wrap: wrap; }
  .go-host { font-weight: 500; margin-left: auto; }
  .go [hidden] { display: none; }
</style>
