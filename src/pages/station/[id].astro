---
// One page per station, generated at build time from public/data/organizations.json.
// Layout is identical for every station; nothing here depends on who built its apps.
import QRCode from 'qrcode';
import Base from '../../layouts/Base.astro';
import AppLink from '../../components/AppLink.astro';
import Icon from '../../components/Icon.astro';
import {
  organizations, facilitiesFor, metaLine, national, PLATFORM_INFO, PLATFORM_ORDER, STATE_NAMES, formatDate, host, verbFor, fallbackVerb,
  type Organization, type Platform,
} from '../../lib/data';
import { url, correctionUrl } from '../../lib/site';

export function getStaticPaths() {
  return organizations.map((org) => ({ params: { id: org.id }, props: { org } }));
}

const { org } = Astro.props as { org: Organization };
// Station first: the station's own app for each platform. Where it has none, link the
// national app of its network (the PBS app for PBS stations) for that platform, labeled
// clearly as the network's app so it's never mistaken for the station's own. Stations with
// both TV and radio get both networks' apps (PBS to watch, NPR to listen). On the web, the
// station's own site is the destination: its web app if it has one (a "Web" card), otherwise
// its website (the hero button, primary on a computer). Never pbs.org or npr.org.
const fallbackBrands = national.filter((b) => org.networks.map((n) => n.toLowerCase()).includes(b.id));
const fallbackBrand = fallbackBrands[0];
interface Item { platform: Platform; href: string; label?: string; detail?: string; fallback: boolean }
const items: Item[] = PLATFORM_ORDER.flatMap((platform): Item[] => {
  const own = org.apps.find((a) => a.platform === platform && !a.extra);
  if (own) {
    const detail = own.kind === 'instructions' ? `${org.name} app · how to get it` : platform === 'web' ? host(own.url) : undefined;
    return [{ platform, href: own.url, detail, fallback: false }];
  }
  // The website itself lives in the hero (one button, never a duplicate card).
  if (platform === 'web') return [];
  return fallbackBrands.flatMap((brand): Item[] => {
    const fb = brand.apps.find((a) => a.platform === platform);
    if (!fb) return [];
    const where = fb.kind === 'help' ? 'how to get it' : PLATFORM_INFO[platform].detail;
    return [{ platform, href: fb.url, detail: `${brand.name} app · ${where}`, fallback: true }];
  });
});
const hasOwnApps = items.some((i) => !i.fallback);

// Extra apps (a station's other apps, e.g. KET Legislative Coverage), grouped by name.
const extraApps = [...org.apps.filter((a) => a.extra).reduce((m, a) => {
  const name = a.name ?? 'Another app';
  m.set(name, [...(m.get(name) ?? []), a].sort((x, y) => PLATFORM_ORDER.indexOf(x.platform) - PLATFORM_ORDER.indexOf(y.platform)));
  return m;
}, new Map<string, typeof org.apps>())];
const verb = verbFor(org.mediaTypes);
const fbVerb = fallbackBrand ? fallbackVerb(fallbackBrand.name) : verb;
// "with the PBS app" / "with the PBS and NPR apps" (only the networks that have that kind of app)
const withApps = (names: string[]) => `with the ${names.join(' and ')} app${names.length > 1 ? 's' : ''}`;
const groupLead = (fallbackItems: Item[]) => {
  const names = fallbackBrands.map((b) => b.name).filter((n) => fallbackItems.some((i) => i.detail?.startsWith(`${n} app`)));
  const verbs = [...new Set(names.map(fallbackVerb))].join(' and ').replace('Watch and Listen', 'Watch and listen');
  return { verbs, names };
};
const GROUP_WHERE = { mobile: 'on your phone or tablet', tv: 'on your TV', web: 'in your browser' } as const;
const groups = (['mobile', 'tv', 'web'] as const)
  .map((key) => ({ key, title: { mobile: 'Phone & tablet', tv: 'TV', web: 'Web' }[key], items: items.filter((i) => PLATFORM_INFO[i.platform].group === key) }))
  .filter((g) => g.items.length)
  .map((g) => ({ ...g, allFallback: g.items.every((i) => i.fallback) }));

const calls = facilitiesFor(org).map((f) => (f.frequency ? `${f.callSign} ${f.frequency}` : f.callSign));
const stateName = STATE_NAMES[org.state] ?? org.state;
const dates = Object.values(org.sources).map((s) => s.retrievedAt).concat(org.apps.map((a) => a.retrievedAt)).sort();
const lastChecked = dates.at(-1);
const sourceKinds = [
  'Wikipedia',
  org.apps.length || org.livestreamUrl ? 'station website' : '',
  Object.values(org.sources).some((s) => s.source.startsWith('manual')) ? 'manual correction' : '',
].filter(Boolean);
// The station's short link for sharing (see src/pages/go/[id].astro).
const goUrl = new URL(url(`/go/${org.id}/`), Astro.site).href;
// QR code for people on a computer: scan with a phone to get the station's app. It encodes
// the share link, which opens a page where the phone offers the station's app. Only for stations with their own
// phone app; drawn at build time (black on white so it scans in dark mode too).
const ownStore = (p: Platform) => org.apps.find((a) => a.platform === p && !a.extra && a.kind !== 'instructions')?.url;
const phoneApps = { ios: ownStore('ios'), android: ownStore('android') };
const appleAppId = phoneApps.ios?.match(/\/id(\d+)/)?.[1];
const hasPhoneApp = !!(phoneApps.ios || phoneApps.android);
const qrSvg = hasPhoneApp ? await QRCode.toString(goUrl, { type: 'svg', margin: 1, errorCorrectionLevel: 'M', color: { dark: '#000000', light: '#ffffff' } }) : null;
const description = `Every way to watch and listen to ${org.name}: apps for phone, tablet, and TV, and website.`;
---

<Base title={org.name} description={description} appleAppId={appleAppId} ogImage={`/og/${org.id}.png`}>
  {(phoneApps.ios || phoneApps.android) && (
    <div class="app-banner" slot="banner" data-app-banner data-ios={phoneApps.ios} data-android={phoneApps.android} hidden>
      <span class="app-banner-icon" aria-hidden="true"><Icon name="phone" /></span>
      <span class="app-banner-text"><span class="body-strong">{org.name} app</span><span class="small muted" data-app-banner-where></span></span>
      <a class="btn btn-primary app-banner-get" href="#" rel="noopener" data-app-banner-get>Get</a>
      <button class="app-banner-close" type="button" data-app-banner-close aria-label="Close">×</button>
    </div>
  )}
  <section class="station-hero">
    <div class="wrap stack gap-24">
      <a class="label back" href={url(`/state/${org.state.toLowerCase()}/`)}>← Stations in {stateName}</a>
      <div class="station-head">
        <div class="stack gap-8">
          <h1 class="display">{org.name}</h1>
          <p class="muted">{metaLine(org)}{calls.length > 0 && <> · On air as {calls.slice(0, 3).map((c, i) => <>{i > 0 && ', '}<span class="nowrap">{c}</span></>)}{calls.length > 3 && <> and {calls.length - 3} more</>}</>}</p>
        </div>
        {qrSvg && (
          <div class="hero-qr" data-qr hidden>
            <div class="qr-img" role="img" aria-label={`QR code that opens the ${org.name} app in your phone's app store`} set:html={qrSvg} />
            <p class="small"><span class="body-strong">On your phone?</span><br />Scan to get the {org.name} app.</p>
          </div>
        )}
      </div>
      <div class="row-wrap hero-actions">
        {/* Filled in by the device script with the best link for this visitor's device. */}
        <a class="btn btn-primary btn-lg" data-smart-cta data-name={org.name} data-fallback={fallbackBrand?.name ?? ''} data-verb={verb} data-fallback-verb={fbVerb} data-has-own={String(hasOwnApps || !!org.livestreamUrl)} href="#apps" hidden><span data-cta-icon="mobile"><Icon name="phone" /></span><span data-cta-icon="desktop" hidden><Icon name="web" /></span><span data-cta-label></span></a>
        {org.livestreamUrl && <a class="btn btn-secondary btn-lg" href={org.livestreamUrl} rel="noopener"><Icon name="live" /><span>{verb} live</span></a>}
        {org.website && <a class="btn btn-secondary btn-lg" href={org.website} rel="noopener" data-website-btn data-name={org.name}><Icon name="web" /><span>Website</span></a>}
      </div>
    </div>
  </section>

  <div class="wrap band">
    <div class="two-col">
      <div class="stack gap-32">

        <section id="apps" class="stack gap-24" aria-label="Apps">
          {!hasOwnApps && fallbackBrands.length === 1 && (
            <p class="muted">
              {fbVerb === 'Listen' ? 'Listen to' : 'Watch'} {org.name} on any device with the {fallbackBrand.name} app, home to many local
              stations' shows and livestreams.
            </p>
          )}
          {!hasOwnApps && fallbackBrands.length > 1 && (
            <p class="muted">
              Watch {org.name} with the PBS app and listen with the NPR app. Both are home to many
              local stations' shows and livestreams.
            </p>
          )}
          {groups.map((g) => (
            <div class="stack gap-12" data-app-group>
              <div class="stack gap-4">
                <h2>{g.title}</h2>
                {hasOwnApps && g.allFallback && fallbackBrand && (
                  <p class="small muted">{groupLead(g.items).verbs} {GROUP_WHERE[g.key]} {withApps(groupLead(g.items).names)}:</p>
                )}
              </div>
              <div class="app-grid">
                {g.items.map((i) => <AppLink platform={i.platform} href={i.href} label={i.label} detail={i.detail} fallback={i.fallback} />)}
              </div>
            </div>
          ))}
          {extraApps.length > 0 && (
            <div class="stack gap-12">
              <h2>More apps from {org.name}</h2>
              <ul class="extra-list">
                {extraApps.map(([name, list]) => (
                  <li class="extra-app">
                    <span class="body-strong">{name}</span>
                    <span class="row-wrap">
                      {list.map((a) => <a class="label" href={a.url} rel="noopener">{PLATFORM_INFO[a.platform].label}</a>)}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          <p class="small muted">New to installing apps? <a href={url('/help/')}>How to get the apps on each device</a></p>
        </section>
      </div>

      <aside class="stack gap-16">
        <div class="outline-box share-box">
          <Icon name="external" />
          <div class="stack gap-8">
            <p class="body-strong">Share {org.name}</p>
            <p class="caption muted">One link for every device: on a phone it opens a page that offers the station's app; on a computer, the station's site.</p>
            <div class="share-row">
              <input class="share-url" type="text" readonly value={goUrl} aria-label={`Link to share ${org.name}`} />
              <button class="btn btn-secondary share-copy" type="button" data-copy={goUrl}>Copy</button>
            </div>
          </div>
        </div>
        <div class="outline-box">
          <Icon name="correction" />
          <div class="stack gap-4">
            <p class="body-strong">Something wrong or missing?</p>
            <a class="label" href={correctionUrl(org.id, org.name)}>Suggest a correction</a>
            <p class="caption muted">
              {lastChecked && <>Last checked {formatDate(lastChecked)} · </>}Sources: {sourceKinds.join(', ')}
            </p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Base>

<script>
  // On a phone: a "Get the app" banner for the station's own app on that platform. iPhone
  // Safari shows Apple's own banner (apple-itunes-app tag), so ours stays out of its way.
  // Closing it lasts for this page view only; nothing is saved.
  import { detectDevice } from '../../scripts/device-detect';
  const banner = document.querySelector<HTMLElement>('[data-app-banner]');
  if (banner) {
    const device = detectDevice();
    const ua = navigator.userAgent;
    const iosSafari = device === 'ios' && /Safari/.test(ua) && !/CriOS|FxiOS|EdgiOS|OPiOS|GSA/.test(ua);
    const link = device === 'ios' ? banner.dataset.ios : device === 'android' ? banner.dataset.android : undefined;
    if (link && !iosSafari) {
      banner.querySelector<HTMLAnchorElement>('[data-app-banner-get]')!.href = link;
      banner.querySelector('[data-app-banner-where]')!.textContent = device === 'ios' ? 'Free on the App Store' : 'Free on Google Play';
      banner.hidden = false;
      banner.querySelector('[data-app-banner-close]')!.addEventListener('click', () => { banner.hidden = true; });
    }
  }

  // "Copy" for the share link. Falls back to selecting the text if the clipboard is blocked.
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copy!);
        b.textContent = 'Copied';
        setTimeout(() => { b.textContent = 'Copy'; }, 2000);
      } catch {
        b.parentElement?.querySelector<HTMLInputElement>('input')?.select();
      }
    });
  }
</script>

<style>
  .nowrap { white-space: nowrap; }
  .station-hero { padding-block: var(--space-32) var(--space-32); background: linear-gradient(135deg, var(--hero-a), var(--bg) 60%, var(--hero-b)); border-bottom: 1px solid var(--border); }
  @media (min-width: 701px) { .station-hero { padding-block: var(--space-48); } }
  .station-head { display: flex; gap: var(--space-24); align-items: center; }
  @media (max-width: 600px) { .station-head { flex-direction: column; align-items: flex-start; gap: var(--space-16); } }
  .hero-actions .btn-lg { flex: 0 1 auto; }
  @media (max-width: 600px) { .hero-actions .btn-lg { flex: 1 1 100%; } }
  .extra-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .extra-app { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-8) var(--space-16); padding: var(--space-12) var(--space-4); border-bottom: 1px solid var(--border); }
  .extra-app .row-wrap { gap: var(--space-16); }
  .hero-qr { margin-left: auto; display: flex; align-items: center; gap: var(--space-16); padding: var(--space-12); border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface-raised); box-shadow: var(--shadow-sm); max-width: 300px; }
  .hero-qr[hidden] { display: none; }
  .hero-qr p { margin: 0; }
  .qr-img { flex: none; width: 112px; height: 112px; background: #fff; border-radius: var(--radius-sm); padding: 4px; }
  .qr-img :global(svg) { width: 100%; height: 100%; display: block; }
  .app-banner { display: flex; align-items: center; gap: var(--space-12); padding: var(--space-8) var(--space-12) var(--space-8) var(--space-16); background: var(--surface-raised); border-bottom: 1px solid var(--border); }
  .app-banner[hidden] { display: none; }
  .app-banner-icon { flex: none; width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; background: var(--accent-subtle); color: var(--accent); }
  .app-banner-icon :global(svg) { width: 22px; height: 22px; }
  .app-banner-text { flex: 1; min-width: 0; display: flex; flex-direction: column; line-height: 1.3; }
  .app-banner-text .body-strong { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .app-banner-get { padding: var(--space-8) var(--space-16); min-height: 0; }
  .app-banner-close { flex: none; border: 0; background: none; color: var(--text-muted); font-size: 22px; width: 36px; height: 36px; cursor: pointer; }
  .share-row { display: flex; gap: var(--space-8); }
  .share-url { flex: 1; min-width: 0; font: inherit; font-size: 14px; color: var(--text); background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: var(--space-8); }
  .share-copy { padding: var(--space-8) var(--space-12); }
  .back { text-decoration: none; }
  .back:hover { text-decoration: underline; }
</style>
