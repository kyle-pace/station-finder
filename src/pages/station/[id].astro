---
// One page per station, generated at build time from public/data/organizations.json.
// Layout is identical for every station; nothing here depends on who built its apps.
import Base from '../../layouts/Base.astro';
import AppLink from '../../components/AppLink.astro';
import Icon from '../../components/Icon.astro';
import {
  organizations, facilitiesFor, metaLine, national, PLATFORM_INFO, PLATFORM_ORDER, STATE_NAMES, formatDate, host, verbFor, fallbackVerb,
  type Organization, type Platform,
} from '../../lib/data';
import { url, correctionUrl } from '../../lib/site';

export function getStaticPaths() {
  return organizations.map((org) => ({ params: { id: org.id }, props: { org } }));
}

const { org } = Astro.props as { org: Organization };
// Station first: the station's own app for each platform. Where it has none, link the
// national app of its network (the PBS app for PBS stations) for that platform, labeled
// clearly as the network's app so it's never mistaken for the station's own. Stations with
// both TV and radio get both networks' apps (PBS to watch, NPR to listen).
const fallbackBrands = national.filter((b) => org.networks.map((n) => n.toLowerCase()).includes(b.id));
const fallbackBrand = fallbackBrands[0];
interface Item { platform: Platform; href: string; label?: string; detail?: string; fallback: boolean }
const items: Item[] = PLATFORM_ORDER.flatMap((platform): Item[] => {
  const own = org.apps.find((a) => a.platform === platform && !a.extra);
  if (own) {
    const detail = own.kind === 'instructions' ? `${org.name} app · how to get it` : platform === 'web' ? host(own.url) : undefined;
    return [{ platform, href: own.url, detail, fallback: false }];
  }
  return fallbackBrands.flatMap((brand): Item[] => {
    const fb = brand.apps.find((a) => a.platform === platform);
    if (!fb) return [];
    const where = platform === 'web' ? host(fb.url) : fb.kind === 'help' ? 'how to get it' : PLATFORM_INFO[platform].detail;
    return [{ platform, href: fb.url, detail: `${brand.name} app · ${where}`, fallback: true }];
  });
});
const hasOwnApps = items.some((i) => !i.fallback);

// Extra apps (a station's other apps, e.g. KET Legislative Coverage), grouped by name.
const extraApps = [...org.apps.filter((a) => a.extra).reduce((m, a) => {
  const name = a.name ?? 'Another app';
  m.set(name, [...(m.get(name) ?? []), a].sort((x, y) => PLATFORM_ORDER.indexOf(x.platform) - PLATFORM_ORDER.indexOf(y.platform)));
  return m;
}, new Map<string, typeof org.apps>())];
const verb = verbFor(org.mediaTypes);
const fbVerb = fallbackBrand ? fallbackVerb(fallbackBrand.name) : verb;
// "with the PBS app" / "with the PBS and NPR apps" (only the networks that have that kind of app)
const withApps = (names: string[]) => `with the ${names.join(' and ')} app${names.length > 1 ? 's' : ''}`;
const groupLead = (fallbackItems: Item[]) => {
  const names = fallbackBrands.map((b) => b.name).filter((n) => fallbackItems.some((i) => i.detail?.startsWith(`${n} app`)));
  const verbs = [...new Set(names.map(fallbackVerb))].join(' and ').replace('Watch and Listen', 'Watch and listen');
  return { verbs, names };
};
const GROUP_WHERE = { mobile: 'on your phone or tablet', tv: 'on your TV', web: 'in your browser' } as const;
const groups = (['mobile', 'tv', 'web'] as const)
  .map((key) => ({ key, title: { mobile: 'Phone & tablet', tv: 'TV', web: 'Web' }[key], items: items.filter((i) => PLATFORM_INFO[i.platform].group === key) }))
  .filter((g) => g.items.length)
  .map((g) => ({ ...g, allFallback: g.items.every((i) => i.fallback) }));

const calls = facilitiesFor(org).map((f) => (f.frequency ? `${f.callSign} ${f.frequency}` : f.callSign));
const stateName = STATE_NAMES[org.state] ?? org.state;
const dates = Object.values(org.sources).map((s) => s.retrievedAt).concat(org.apps.map((a) => a.retrievedAt)).sort();
const lastChecked = dates.at(-1);
const sourceKinds = [
  'Wikipedia',
  org.apps.length || org.livestreamUrl ? 'station website' : '',
  Object.values(org.sources).some((s) => s.source.startsWith('manual')) ? 'manual correction' : '',
].filter(Boolean);
const description = `Every way to watch and listen to ${org.name}: apps for phone, tablet, and TV, livestream, and website.`;
---

<Base title={org.name} description={description}>
  <section class="station-hero">
    <div class="wrap stack gap-24">
      <a class="label back" href={url(`/state/${org.state.toLowerCase()}/`)}>← Stations in {stateName}</a>
      <div class="station-head">
        <div class="stack gap-8">
          <h1 class="display">{org.name}</h1>
          <p class="muted">{metaLine(org)}{calls.length > 0 && <> · On air as {calls.slice(0, 3).map((c, i) => <>{i > 0 && ', '}<span class="nowrap">{c}</span></>)}{calls.length > 3 && <> and {calls.length - 3} more</>}</>}</p>
        </div>
      </div>
      <div class="row-wrap hero-actions">
        {/* Filled in by the device script with the best link for this visitor's device. */}
        <a class="btn btn-primary btn-lg" data-smart-cta data-name={org.name} data-fallback={fallbackBrand?.name ?? ''} data-verb={verb} data-fallback-verb={fbVerb} data-has-own={String(hasOwnApps || !!org.livestreamUrl)} href="#apps" hidden><span data-cta-icon="mobile"><Icon name="phone" /></span><span data-cta-icon="desktop" hidden><Icon name="web" /></span><span data-cta-label></span></a>
        {org.livestreamUrl && <a class="btn btn-secondary btn-lg" href={org.livestreamUrl} rel="noopener"><Icon name="live" /><span>{verb} live</span></a>}
        {org.website && <a class="btn btn-secondary btn-lg" href={org.website} rel="noopener"><Icon name="web" /><span>Website</span></a>}
      </div>
    </div>
  </section>

  <div class="wrap band">
    <div class="two-col">
      <div class="stack gap-32">

        <section id="apps" class="stack gap-24" aria-label="Apps">
          {!hasOwnApps && fallbackBrands.length === 1 && (
            <p class="muted">
              {fbVerb === 'Listen' ? 'Listen to' : 'Watch'} {org.name} on any device with the {fallbackBrand.name} app, home to many local
              stations' shows and livestreams.
            </p>
          )}
          {!hasOwnApps && fallbackBrands.length > 1 && (
            <p class="muted">
              Watch {org.name} with the PBS app and listen with the NPR app. Both are home to many
              local stations' shows and livestreams.
            </p>
          )}
          {groups.map((g) => (
            <div class="stack gap-12" data-app-group>
              <div class="stack gap-4">
                <h2>{g.title}</h2>
                {hasOwnApps && g.allFallback && fallbackBrand && (
                  <p class="small muted">{groupLead(g.items).verbs} {GROUP_WHERE[g.key]} {withApps(groupLead(g.items).names)}:</p>
                )}
              </div>
              <div class="app-grid">
                {g.items.map((i) => <AppLink platform={i.platform} href={i.href} detail={i.detail} fallback={i.fallback} />)}
              </div>
            </div>
          ))}
          {extraApps.length > 0 && (
            <div class="stack gap-12">
              <h2>More apps from {org.name}</h2>
              <ul class="extra-list">
                {extraApps.map(([name, list]) => (
                  <li class="extra-app">
                    <span class="body-strong">{name}</span>
                    <span class="row-wrap">
                      {list.map((a) => <a class="label" href={a.url} rel="noopener">{PLATFORM_INFO[a.platform].label}</a>)}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          <p class="small muted">New to installing apps? <a href={url('/help/')}>How to get the apps on each device</a></p>
        </section>
      </div>

      <aside class="stack gap-16">
        <div class="outline-box">
          <Icon name="correction" />
          <div class="stack gap-4">
            <p class="body-strong">Something wrong or missing?</p>
            <a class="label" href={correctionUrl(org.id, org.name)}>Suggest a correction</a>
            <p class="caption muted">
              {lastChecked && <>Last checked {formatDate(lastChecked)} · </>}Sources: {sourceKinds.join(', ')}
            </p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .nowrap { white-space: nowrap; }
  .station-hero { padding-block: var(--space-32) var(--space-32); background: linear-gradient(135deg, var(--hero-a), var(--bg) 60%, var(--hero-b)); border-bottom: 1px solid var(--border); }
  @media (min-width: 701px) { .station-hero { padding-block: var(--space-48); } }
  .station-head { display: flex; gap: var(--space-24); align-items: center; }
  @media (max-width: 600px) { .station-head { flex-direction: column; align-items: flex-start; gap: var(--space-16); } }
  .hero-actions .btn-lg { flex: 0 1 auto; }
  @media (max-width: 600px) { .hero-actions .btn-lg { flex: 1 1 100%; } }
  .extra-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .extra-app { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-8) var(--space-16); padding: var(--space-12) var(--space-4); border-bottom: 1px solid var(--border); }
  .extra-app .row-wrap { gap: var(--space-16); }
  .back { text-decoration: none; }
  .back:hover { text-decoration: underline; }
</style>
