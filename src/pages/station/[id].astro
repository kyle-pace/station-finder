---
// One page per station, generated at build time from public/data/organizations.json.
// Layout is identical for every station; nothing here depends on who built its apps.
import Base from '../../layouts/Base.astro';
import AppLink from '../../components/AppLink.astro';
import Icon from '../../components/Icon.astro';
import {
  organizations, facilitiesFor, metaLine, national, PLATFORM_INFO, PLATFORM_ORDER, STATE_NAMES, formatDate, host,
  type Organization, type Platform,
} from '../../lib/data';
import { url, correctionUrl } from '../../lib/site';

export function getStaticPaths() {
  return organizations.map((org) => ({ params: { id: org.id }, props: { org } }));
}

const { org } = Astro.props as { org: Organization };
// Station first: the station's own app for each platform. Where it has none, link the
// national app of its network (the PBS app for PBS stations) for that platform, labeled
// clearly as the network's app so it's never mistaken for the station's own.
const fallbackBrand = national.find((b) => org.networks.map((n) => n.toLowerCase()).includes(b.id));
interface Item { platform: Platform; href: string; label?: string; detail?: string; fallback: boolean }
const items: Item[] = PLATFORM_ORDER.flatMap((platform): Item[] => {
  const own = org.apps.find((a) => a.platform === platform && !a.extra);
  if (own) {
    const detail = own.kind === 'instructions' ? `${org.name} app · how to get it` : platform === 'web' ? host(own.url) : undefined;
    return [{ platform, href: own.url, detail, fallback: false }];
  }
  const fb = fallbackBrand?.apps.find((a) => a.platform === platform);
  if (!fb) return [];
  const where = platform === 'web' ? host(fb.url) : fb.kind === 'help' ? 'how to get it' : PLATFORM_INFO[platform].detail;
  return [{ platform, href: fb.url, detail: `${fallbackBrand!.name} app · ${where}`, fallback: true }];
});
const hasOwnApps = items.some((i) => !i.fallback);

// Extra apps (a station's other apps, e.g. KET Legislative Coverage), grouped by name.
const extraApps = [...org.apps.filter((a) => a.extra).reduce((m, a) => {
  const name = a.name ?? 'Another app';
  m.set(name, [...(m.get(name) ?? []), a].sort((x, y) => PLATFORM_ORDER.indexOf(x.platform) - PLATFORM_ORDER.indexOf(y.platform)));
  return m;
}, new Map<string, typeof org.apps>())];
const GROUP_WORDS = { mobile: 'Watch on your phone or tablet', tv: 'Watch on your TV', web: 'Watch in your browser' } as const;
const groups = (['mobile', 'tv', 'web'] as const)
  .map((key) => ({ key, title: { mobile: 'Phone & tablet', tv: 'TV', web: 'Web' }[key], items: items.filter((i) => PLATFORM_INFO[i.platform].group === key) }))
  .filter((g) => g.items.length)
  .map((g) => ({ ...g, allFallback: g.items.every((i) => i.fallback) }));

const calls = facilitiesFor(org).map((f) => f.callSign);
const stateName = STATE_NAMES[org.state] ?? org.state;
const dates = Object.values(org.sources).map((s) => s.retrievedAt).concat(org.apps.map((a) => a.retrievedAt)).sort();
const lastChecked = dates.at(-1);
const sourceKinds = [
  'Wikipedia',
  org.apps.length || org.livestreamUrl ? 'station website' : '',
  Object.values(org.sources).some((s) => s.source.startsWith('manual')) ? 'manual correction' : '',
].filter(Boolean);
const description = `Every way to watch ${org.name}: apps for phone, tablet, and TV, livestream, and website.`;
---

<Base title={org.name} description={description}>
  <div class="wrap band">
    <div class="two-col">
      <div class="stack gap-32">
        <div class="stack gap-8">
          <a class="label back" href={url(`/state/${org.state.toLowerCase()}/`)}>← Stations in {stateName}</a>
          <h1 class="display">{org.name}</h1>
          <p class="muted">{metaLine(org)}{calls.length > 0 && <> · On air as {calls.slice(0, 3).map((c, i) => <>{i > 0 && ', '}<span class="nowrap">{c}</span></>)}{calls.length > 3 && <> and {calls.length - 3} more</>}</>}</p>
        </div>

        {(org.livestreamUrl || org.website) && (
          <div class="row-wrap">
            {org.livestreamUrl && <a class="btn btn-primary" href={org.livestreamUrl} rel="noopener"><Icon name="live" /><span>Watch live</span></a>}
            {org.website && <a class={`btn ${org.livestreamUrl ? 'btn-secondary' : 'btn-primary'}`} href={org.website} rel="noopener"><Icon name="web" /><span>Website</span></a>}
          </div>
        )}

        <section id="apps" class="stack gap-24" aria-label="Apps">
          {!hasOwnApps && fallbackBrand && (
            <p class="muted">
              Watch {org.name} on any device with the {fallbackBrand.name} app, home to many local
              stations' shows and livestreams.
            </p>
          )}
          {groups.map((g) => (
            <div class="stack gap-12" data-app-group>
              <div class="stack gap-4">
                <h2>{g.title}</h2>
                {hasOwnApps && g.allFallback && fallbackBrand && (
                  <p class="small muted">{GROUP_WORDS[g.key]} with the {fallbackBrand.name} app:</p>
                )}
              </div>
              <div class="app-grid">
                {g.items.map((i) => <AppLink platform={i.platform} href={i.href} detail={i.detail} fallback={i.fallback} />)}
              </div>
            </div>
          ))}
          {extraApps.length > 0 && (
            <div class="stack gap-12">
              <h2>More apps from {org.name}</h2>
              <ul class="extra-list">
                {extraApps.map(([name, list]) => (
                  <li class="extra-app">
                    <span class="body-strong">{name}</span>
                    <span class="row-wrap">
                      {list.map((a) => <a class="label" href={a.url} rel="noopener">{PLATFORM_INFO[a.platform].label}</a>)}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </section>
      </div>

      <aside class="stack gap-16">
        <div class="outline-box">
          <Icon name="correction" />
          <div class="stack gap-4">
            <p class="body-strong">Something wrong or missing?</p>
            <a class="label" href={correctionUrl(org.id, org.name)}>Suggest a correction</a>
            <p class="caption muted">
              {lastChecked && <>Last checked {formatDate(lastChecked)} · </>}Sources: {sourceKinds.join(', ')}
            </p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .nowrap { white-space: nowrap; }
  .extra-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  .extra-app { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-8) var(--space-16); padding: var(--space-12) var(--space-4); border-bottom: 1px solid var(--border); }
  .extra-app .row-wrap { gap: var(--space-16); }
  .back { text-decoration: none; }
  .back:hover { text-decoration: underline; }
</style>
