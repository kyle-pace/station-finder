---
import Base from '../layouts/Base.astro';
import SearchForm from '../components/SearchForm.astro';
import DotMap from '../components/DotMap.astro';
import Icon from '../components/Icon.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { organizations, facilities, statesWithStations, facilitiesFor } from '../lib/data';
import { url } from '../lib/site';

const stationCount = organizations.length;
const transmitterCount = facilities.length;

// "Try" examples: the browser picks a ZIP, a city, and call letters from three different
// stations at random on each visit, so no station is featured. Each entry is
// [ZIP nearest the station's home city, "City, ST", call letters].
const zips = Object.entries((JSON.parse(readFileSync(join(process.cwd(), 'data', 'raw', 'census', 'zcta.json'), 'utf8')) as { zips: Record<string, [number, number]> }).zips);
const nearestZip = (lat: number, lng: number) => {
  let best = '', bestD = Infinity;
  for (const [zip, [la, ln]] of zips) {
    const d = (la - lat) ** 2 + ((ln - lng) * Math.cos((lat * Math.PI) / 180)) ** 2;
    if (d < bestD) { bestD = d; best = zip; }
  }
  return best;
};
const examplePool = organizations.flatMap((o) => {
  const call = facilitiesFor(o)[0]?.callSign.replace(/-.*$/, '');
  if (!o.home?.city || !call || !/^[KW][A-Z]{2,3}$/.test(call)) return [];
  return [[nearestZip(o.home.lat, o.home.lng), `${o.home.city}, ${o.state}`, call]];
});
---

<Base>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy stack gap-24">
        <div class="stack gap-16">
          <p class="eyebrow">Public media, near you</p>
          <h1 class="display">Every way to watch and listen to your local station</h1>
          <p class="lede muted">Find your local public TV and radio station, then get its own apps for your phone, tablet, and TV, plus its website.</p>
        </div>
        <SearchForm size="lg" examplePool={examplePool} />
      </div>
      <figure class="hero-visual">
        <DotMap class="hero-map" dotRadius={2.6} live />
        <figcaption>
          <span class="caption muted">Every dot is a public TV or radio transmitter: {transmitterCount.toLocaleString('en-US')} of them, run by {stationCount} local stations.</span>
          <a class="label" href={url('/state/#map')}>Browse all stations by state →</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="band" aria-labelledby="how">
    <div class="wrap stack gap-24">
      <h2 id="how">How it works</h2>
      <ol class="steps">
        <li class="step"><span class="step-num">1</span><div class="stack gap-4"><p class="body-strong">Search</p><p class="small muted">Type your ZIP code, city, station name, or call letters. Results appear as you type.</p></div></li>
        <li class="step"><span class="step-num">2</span><div class="stack gap-4"><p class="body-strong">Pick your station</p><p class="small muted">Stations near you, nearest first. Every station is listed the same way.</p></div></li>
        <li class="step"><span class="step-num">3</span><div class="stack gap-4"><p class="body-strong">Get the right app</p><p class="small muted">We show the app for the device you're on first, plus every other way to watch and listen.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="band band-surface" aria-labelledby="why">
    <div class="wrap stack gap-24">
      <div class="stack gap-8 section-head">
        <p class="eyebrow">Why it matters</p>
        <h2 id="why">Your local station is made for your community</h2>
        <p class="muted">Public media is one of the few places on the air made for where you live, by people who live there.</p>
      </div>
      <ul class="points">
        <li><span class="point-icon"><Icon name="location" /></span><p class="body-strong">Made where you live</p><p class="small muted">Local stations make and choose programs for their communities: local news and public affairs, music, arts, history, and learning you won't find on national channels.</p></li>
        <li><span class="point-icon"><Icon name="radio" /></span><p class="body-strong">Free and open to everyone</p><p class="small muted">Public TV and radio are free to watch and listen to over the air, and stations share much of what they make online and in their apps.</p></li>
        <li><span class="point-icon"><Icon name="web" /></span><p class="body-strong">Rooted in the community</p><p class="small muted">Stations are local nonprofits, universities, and public agencies, answerable to the people they serve rather than to advertisers.</p></li>
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="apps-why">
    <div class="wrap stack gap-24">
      <div class="stack gap-8 section-head">
        <p class="eyebrow">Why the station's app</p>
        <h2 id="apps-why">The best way to watch and listen</h2>
        <p class="muted">Your station's own app brings together everything it offers, and it helps the station too.</p>
      </div>
      <ul class="points">
        <li><span class="point-icon"><Icon name="live" /></span><p class="body-strong">Everything local in one place</p><p class="small muted">Your station's livestream, its local shows and programs, and its schedule, not just the national lineup.</p></li>
        <li><span class="point-icon"><Icon name="phone" /></span><p class="body-strong">Made for your screen</p><p class="small muted">Apps are built for your phone, tablet, or TV, so it's quicker to start watching or listening than on a website.</p></li>
        <li><span class="point-icon"><Icon name="donate" /></span><p class="body-strong">A direct line to your station</p><p class="small muted">When you use its own app, your station keeps a direct connection with its audience and a clearer picture of what its community values.</p></li>
      </ul>
      <p><a class="label" href={url('/about/#why')}>Why we built this →</a></p>
    </div>
  </section>

  <section class="band" aria-labelledby="map-teaser">
    <div class="wrap">
      <a class="teaser" href={url('/state/#map')}>
        <div class="stack gap-12 teaser-copy">
          <p class="eyebrow">Explore</p>
          <h2 id="map-teaser">Every station on the map</h2>
          <p class="muted">{stationCount} stations and {transmitterCount} transmitters across the country. Zoom into your state and tap a dot to learn about a station.</p>
          <span class="btn btn-primary">Open the map →</span>
        </div>
      </a>
    </div>
  </section>

  <section class="band band-surface" aria-labelledby="states">
    <div class="wrap stack gap-16">
      <h2 id="states">Browse by state</h2>
      <ul class="row-wrap" role="list" style="list-style:none;margin:0;padding:0">
        {statesWithStations.map((s) => (
          <li><a class="chip" href={url(`/state/${s.code.toLowerCase()}/`)}>{s.name}</a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>


<style>
  /* The teal brand panel. Text on it is light; the search box and cards keep their own
     colors. Map dots switch to lighter shades so they read on teal. */
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    background:
      radial-gradient(900px 420px at 90% -10%, color-mix(in srgb, var(--warm) 22%, transparent), transparent 60%),
      var(--brand-panel);
    --tv: #c3cbff; --radio: #ffb59c;
  }
  /* Dark mode keeps the original soft-glow hero instead of a flat teal block. */
  @media (prefers-color-scheme: dark) {
    .hero {
      background:
        radial-gradient(1200px 500px at 85% -10%, color-mix(in srgb, var(--warm) 14%, transparent), transparent 60%),
        radial-gradient(900px 500px at 0% 0%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 60%),
        linear-gradient(135deg, var(--hero-a) 0%, var(--bg) 55%, var(--hero-b) 100%);
      border-bottom: 1px solid var(--border);
      --tv: #8fb0ff; --radio: #ff8a5c;
    }
    .hero :global(.land) { fill: color-mix(in srgb, var(--tv) 7%, transparent); stroke: color-mix(in srgb, var(--tv) 18%, transparent); }
  }
  .hero h1, .hero .display { color: #ffffff; }
  .hero .lede { color: #d6e8e6; }
  .hero .eyebrow { color: #ffd2c2; }
  .hero :global(.examples) { color: #d6e8e6; }
  .hero :global(.btn-primary) { background: var(--warm); color: #0e1a1b; }
  .hero :global(.btn-primary:hover) { background: #ff9478; }
  .hero :global(.land) { fill: rgb(255 255 255 / 0.07); stroke: rgb(255 255 255 / 0.22); }
  .hero .hero-visual figcaption .caption { color: #d6e8e6; }
  .hero .hero-visual figcaption .label { color: #ffd2c2; }
  .hero-inner { display: grid; gap: var(--space-40, 40px); align-items: center; padding-block: var(--space-48) var(--space-48); }
  @media (min-width: 701px) { .hero-inner { padding-block: 72px 80px; } }
  .hero-visual { margin: 0; display: flex; flex-direction: column; gap: var(--space-8); min-width: 0; }
  .hero-visual figcaption { display: flex; flex-direction: column; align-items: center; gap: var(--space-8); text-align: center; }
  @media (min-width: 1024px) {
    .hero-inner { grid-template-columns: minmax(0, 580px) minmax(0, 1fr); gap: var(--space-24); }
    .hero-visual { margin-right: -56px; }
  }
  @media (min-width: 1400px) { .hero-visual { margin-right: -150px; margin-left: var(--space-16); } }
  .hero-copy { max-width: 640px; }
  .lede { font-size: 19px; line-height: 29px; max-width: 560px; }

  .section-head { max-width: 640px; }
  .points { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-24); }
  @media (min-width: 701px) { .points { grid-template-columns: repeat(3, 1fr); gap: var(--space-32); } }
  .points li { display: flex; flex-direction: column; gap: var(--space-8); }
  .point-icon { width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center; background: color-mix(in srgb, var(--warm) 14%, transparent); color: var(--warm); margin-bottom: var(--space-4); }
  .point-icon svg { width: 22px; height: 22px; }

  .teaser {
    display: grid; gap: var(--space-24); align-items: center; padding: var(--space-24); text-decoration: none; color: inherit;
    border: 1px solid var(--border); border-radius: var(--radius-lg); background: linear-gradient(135deg, var(--hero-a), var(--surface-raised));
    box-shadow: var(--shadow-sm); transition: box-shadow 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .teaser:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
  @media (min-width: 801px) { .teaser { padding: var(--space-40, 40px) var(--space-48); } }
  .teaser-copy { align-items: flex-start; }

</style>
