---
import Base from '../layouts/Base.astro';
import SearchForm from '../components/SearchForm.astro';
import Icon from '../components/Icon.astro';
import { statesWithStations } from '../lib/data';
import { url } from '../lib/site';
---

<Base>
  <section class="band-lg">
    <div class="wrap narrow stack gap-16">
      <h1 class="display">Find your local public media station</h1>
      <p class="muted">Every way to watch your local public media station: its own apps for your phone, tablet, and TV, its livestream, and its website.</p>
      <SearchForm />
      <div class="location" hidden data-location>
        <button class="btn btn-quiet" type="button" data-locate><Icon name="location" /><span>Use my location</span></button>
        <p class="caption muted">Your location is used on this device only and never sent to us.</p>
      </div>
    </div>
  </section>

  <section class="band band-surface" aria-labelledby="how">
    <div class="wrap stack gap-24">
      <h2 id="how">How it works</h2>
      <ol class="steps">
        <li class="step"><span class="step-num">1</span><div class="stack gap-4"><p class="body-strong">Search</p><p class="small muted">Enter your ZIP code, city, station name, or call letters.</p></div></li>
        <li class="step"><span class="step-num">2</span><div class="stack gap-4"><p class="body-strong">Pick your station</p><p class="small muted">Stations near you, nearest first. Every station is listed the same way.</p></div></li>
        <li class="step"><span class="step-num">3</span><div class="stack gap-4"><p class="body-strong">Get the right app</p><p class="small muted">We show the app for the device you're on first, plus every other way to watch and listen.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="band" aria-labelledby="why">
    <div class="wrap stack gap-24">
      <div class="stack gap-8">
        <h2 id="why">Why your local station matters</h2>
        <p class="muted">Public media is one of the few places on TV that's made for your community, by people who live in it.</p>
      </div>
      <ul class="points">
        <li><p class="body-strong">Made where you live</p><p class="small muted">Local stations make and choose programs for their own communities: local news and public affairs, arts, history, and learning you won't find on national channels.</p></li>
        <li><p class="body-strong">Free and open to everyone</p><p class="small muted">Public television is free to watch over the air, and stations share much of what they make online and in their apps.</p></li>
        <li><p class="body-strong">Rooted in the community</p><p class="small muted">Stations are local nonprofits, universities, and public agencies, answerable to the people they serve rather than to advertisers.</p></li>
      </ul>
    </div>
  </section>

  <section class="band band-surface" aria-labelledby="apps-why">
    <div class="wrap stack gap-24">
      <div class="stack gap-8">
        <h2 id="apps-why">Why use your station's own app</h2>
        <p class="muted">Watching through your station's app is the best way to see everything it offers, and it helps the station too.</p>
      </div>
      <ul class="points">
        <li><p class="body-strong">Everything local in one place</p><p class="small muted">Your station's livestream, its local shows, and its schedule, not just the national lineup.</p></li>
        <li><p class="body-strong">Made for your screen</p><p class="small muted">Apps are built for your phone, tablet, or TV, so it's quicker to start watching than on a website.</p></li>
        <li><p class="body-strong">A direct line to your station</p><p class="small muted">When you watch in its own app, your station keeps a direct connection with its audience and a clearer picture of what its community values.</p></li>
      </ul>
      <p><a class="label" href={url('/about/#why')}>Why we built this →</a></p>
    </div>
  </section>

  <section class="band" aria-labelledby="states">
    <div class="wrap stack gap-16">
      <h2 id="states">Browse by state</h2>
      <ul class="row-wrap" role="list" style="list-style:none;margin:0;padding:0">
        {statesWithStations.map((s) => (
          <li><a class="chip" href={url(`/state/${s.code.toLowerCase()}/`)}>{s.name}</a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<script>
  // "Use my location": only offered when the browser supports it. The coordinates are
  // rounded (~1 km) and only go into this site's own search URL.
  const box = document.querySelector<HTMLElement>('[data-location]');
  if (box && 'geolocation' in navigator) {
    box.hidden = false;
    const button = box.querySelector<HTMLButtonElement>('[data-locate]')!;
    const label = button.querySelector('span')!;
    button.addEventListener('click', () => {
      label.textContent = 'Finding you…';
      navigator.geolocation.getCurrentPosition(
        (pos) => {
          const near = `${pos.coords.latitude.toFixed(2)},${pos.coords.longitude.toFixed(2)}`;
          location.href = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/search/?near=${near}`;
        },
        () => { label.textContent = "Couldn't get your location — try a ZIP code"; },
        { maximumAge: 600000, timeout: 10000 },
      );
    });
  }
</script>

<style>
  .points { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-16); }
  @media (min-width: 701px) { .points { grid-template-columns: repeat(3, 1fr); gap: var(--space-24); } }
  .points li { display: flex; flex-direction: column; gap: var(--space-4); }
  .location { display: flex; flex-direction: column; gap: var(--space-4); align-items: flex-start; }
  @media (min-width: 701px) { .location { flex-direction: row; align-items: center; gap: var(--space-12); } }
</style>
