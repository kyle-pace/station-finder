---
// Map of every station, one marker where each station is based (its home city), drawn
// as plain SVG at build time: no map tiles and no requests to any other server. State
// outlines come from the us-atlas package (U.S. Census cartographic boundaries,
// pre-projected to Albers USA, 975×610).
//
// Markers: TV stations are blue squares, radio stations orange circles, and stations
// with both are a half-blue, half-orange square. Markers that would overlap on screen
// are grouped into a numbered bubble (its ring shows the TV/radio mix); clicking one
// zooms in until they separate.
//
// Interaction (all in the browser, nothing sent anywhere):
//   - show all stations, TV only, or radio only
//   - zoom: click/tap a state or a bubble, the + and − buttons, pinch or drag on a
//     phone, ctrl/⌘ + scroll or a trackpad pinch on a computer, double-click;
//     "All of the US", Esc, or clicking outside the states zooms back out
//   - the list beside the map shows every station in view; hovering a name points
//     to its marker
//   - hover a marker: a small card about the station; click to open the station. On
//     touch screens, a tap shows the card and its button opens the station page. Without JavaScript the markers are plain links.
// Every marker and card looks the same for every station.
//
// Places outside the Albers USA projection (Puerto Rico and other territories) aren't
// drawn; they're in the list of states and territories on the same page.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { feature, mesh } from 'topojson-client';
import { geoAlbersUsa, geoPath } from 'd3-geo';
import type { Topology, GeometryCollection } from 'topojson-specification';
import { organizations, national, metaLine, statesOf, facilitiesFor, PLATFORM_INFO, PLATFORM_ORDER, STATE_NAMES } from '../lib/data';
import { url } from '../lib/site';
import Icon from './Icon.astro';

const topo = JSON.parse(readFileSync(join(process.cwd(), 'node_modules', 'us-atlas', 'states-albers-10m.json'), 'utf8')) as Topology;
const statesObj = topo.objects.states as GeometryCollection<{ name: string }>;
const path = geoPath().digits(1); // shapes are already projected
const projection = geoAlbersUsa().scale(1300).translate([487.5, 305]); // matches us-atlas *-albers files
const codeByName = Object.fromEntries(Object.entries(STATE_NAMES).map(([code, name]) => [name, code]));

type Kind = 'tv' | 'radio' | 'both';
const kindOf = (m: string[]): Kind => (m.includes('tv') ? (m.includes('radio') ? 'both' : 'tv') : 'radio');

// Station counts per state for each filter (a station counts in every state it broadcasts in).
const counts = new Map<string, { all: number; tv: number; radio: number }>();
for (const o of organizations) {
  const k = kindOf(o.mediaTypes);
  for (const st of statesOf(o)) {
    const c = counts.get(st) ?? { all: 0, tv: 0, radio: 0 };
    c.all++;
    if (k !== 'radio') c.tv++;
    if (k !== 'tv') c.radio++;
    counts.set(st, c);
  }
}

const states = feature(topo, statesObj).features.map((f) => {
  const code = codeByName[f.properties.name] ?? '';
  const [[x0, y0], [x1, y1]] = path.bounds(f);
  const c = counts.get(code) ?? { all: 0, tv: 0, radio: 0 };
  return { code, name: f.properties.name, d: path(f) ?? '', box: [x0, y0, x1 - x0, y1 - y0].map((n) => Math.round(n)).join(' '), c };
});
const borders = path(mesh(topo, statesObj, (a, b) => a !== b)) ?? '';

// One marker per station. Stations based in the same city are fanned out in a small
// sunflower pattern so each one can be picked once you zoom in.
const placed: { x: number; y: number; id: string; kind: Kind; label: string }[] = [];
for (const o of organizations) {
  if (!o.home) continue;
  const p = projection([o.home.lng, o.home.lat]);
  if (!p) continue;
  placed.push({ x: p[0], y: p[1], id: o.id, kind: kindOf(o.mediaTypes), label: `${o.name}, ${o.home.city ?? STATE_NAMES[o.state]}` });
}
const sameCity = new Map<string, typeof placed>();
for (const d of placed) {
  const key = `${Math.round(d.x / 2)},${Math.round(d.y / 2)}`;
  sameCity.set(key, [...(sameCity.get(key) ?? []), d]);
}
const dots = [...sameCity.values()].flatMap((group) =>
  group.sort((a, b) => a.label.localeCompare(b.label)).map((d, i) => {
    if (group.length === 1) return d;
    const angle = i * 2.39996; // golden angle
    const r = 1.4 * Math.sqrt(i + 0.5);
    return { ...d, x: d.x + r * Math.cos(angle), y: d.y + r * Math.sin(angle) };
  }),
).map((d) => ({ ...d, x: Math.round(d.x * 10) / 10, y: Math.round(d.y * 10) / 10 }));
const total = { all: dots.length, tv: dots.filter((d) => d.kind !== 'radio').length, radio: dots.filter((d) => d.kind !== 'tv').length };

// What the card and list say about each station (same fields for every station).
const info = Object.fromEntries(
  dots.map(({ id, kind }) => {
    const o = organizations.find((x) => x.id === id)!;
    const own = PLATFORM_ORDER.filter((p) => o.apps.some((a) => a.platform === p && !a.extra));
    const fallbacks = national.filter((b) => o.networks.map((n) => n.toLowerCase()).includes(b.id)).map((b) => `${b.name === 'NPR' ? 'Listen' : 'Watch'} with the ${b.name} app`);
    const fac = facilitiesFor(o);
    const main = fac.find((f) => o.name.toUpperCase().startsWith(f.callSign.replace(/-.*$/, '')));
    const calls = [...(main ? [main] : []), ...fac.filter((f) => f !== main)].map((f) => (f.frequency ? `${f.callSign} ${f.frequency}` : f.callSign));
    const where = o.home?.city ? `${o.home.city}, ${o.state}` : (STATE_NAMES[o.state] ?? o.state);
    return [id, {
      name: o.name,
      kind,
      states: statesOf(o),
      sub: `${{ tv: 'TV', radio: 'Radio', both: 'TV & radio' }[kind]} · ${where}`,
      meta: metaLine(o),
      calls: calls.length ? `On air as ${calls[0]}${calls.length > 1 ? ` + ${calls.length - 1} more` : ''}` : '',
      apps: own.map((p) => PLATFORM_INFO[p].label.replace(/^On the web$/, 'Web')),
      fallback: fallbacks.join(' · ') || null,
      live: !!o.livestreamUrl,
      href: url(`/station/${id}/`),
    }];
  }),
);
const FILTERS = [
  { key: 'all', label: 'All', n: total.all },
  { key: 'tv', label: 'TV', n: total.tv },
  { key: 'radio', label: 'Radio', n: total.radio },
] as const;
---
<div class="station-map" id="map" data-map data-total={JSON.stringify(total)}>
  <div class="map-bar">
    <div class="filters" role="group" aria-label="Show">
      {FILTERS.map((f) => (
        <button type="button" class="filter" data-filter={f.key} aria-pressed={f.key === 'all' ? 'true' : 'false'}>
          {f.key !== 'all' && <span class:list={['key', f.key]} aria-hidden="true"></span>}
          {f.label} <span class="n">{f.n}</span>
        </button>
      ))}
    </div>
    <p class="legend caption muted" aria-hidden="true">
      <span><span class="key tv"></span>TV station</span>
      <span><span class="key radio"></span>Radio station</span>
      <span><span class="key both"></span>TV &amp; radio</span>
      <span><span class="key group">3</span>Several stations</span>
    </p>
  </div>
  <p class="small muted" data-map-status aria-live="polite">Pick a state or zoom in, then a marker to learn about that station.</p>

  <div class="map-layout">
    <div class="map-col">
      <div class="map-frame" data-frame>
        <svg viewBox="0 0 975 610" role="group" aria-label="Map of public media stations in the United States. Every station is also in the station list next to the map and in the list of states below it.">
          <defs>
            <linearGradient id="map-split" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0.5" class="stop-tv" /><stop offset="0.5" class="stop-radio" />
            </linearGradient>
          </defs>
          <g class="states">
            {states.map((s) => (
              <path d={s.d} data-state={s.code} data-name={s.name} data-box={s.box} data-all={s.c.all} data-tv={s.c.tv} data-radio={s.c.radio} />
            ))}
          </g>
          <path class="borders" d={borders} />
          <g class="dots" aria-hidden="true">
            {dots.map((d) => (
              <a href={url(`/station/${d.id}/`)} tabindex="-1" aria-label={d.label} data-org={d.id} data-x={d.x} data-y={d.y} class:list={['dot', d.kind]}>
                <g transform={`translate(${d.x} ${d.y})`}><g class="m">
                  <circle class="hit" r="2" />
                  {d.kind === 'radio'
                    ? <circle class="shape" r="1" />
                    : <rect class="shape" x="-0.9" y="-0.9" width="1.8" height="1.8" rx="0.4" fill={d.kind === 'both' ? 'url(#map-split)' : undefined} />}
                </g></g>
              </a>
            ))}
          </g>
          <g class="clusters" data-clusters aria-hidden="true"></g>
        </svg>
        <div class="zoom-controls">
          <button type="button" class="zoom-btn" data-zoom="in" aria-label="Zoom in">+</button>
          <button type="button" class="zoom-btn" data-zoom="out" aria-label="Zoom out">−</button>
          <button type="button" class="zoom-btn" data-zoom="reset" aria-label="Show all of the US" title="All of the US" hidden><Icon name="fit" /></button>
        </div>
        <p class="map-tip caption" data-map-tip hidden></p>
        <div class="map-card" data-map-card role="dialog" aria-label="Station details" hidden>
          <button class="card-close" type="button" data-card-close aria-label="Close">×</button>
          <p class="h3" data-card-name></p>
          <p class="small muted" data-card-meta></p>
          <p class="small" data-card-apps></p>
          <p class="small" data-card-live hidden><span class="live-dot" aria-hidden="true"></span>Livestream available</p>
          <ul class="card-list" data-card-list hidden></ul>
          <a class="btn btn-primary" data-card-link href="#">View station →</a>
        </div>
      </div>
      <div class="map-foot">
        <button class="btn btn-secondary" type="button" data-map-reset hidden>← Zoom out to all of the US</button>
        <a class="label" data-map-state-link hidden href="#"></a>
      </div>
    </div>

    <aside class="map-list" aria-label="Stations in view" data-list-panel hidden>
      <p class="label list-head" data-list-head></p>
      <ul data-list></ul>
    </aside>
  </div>

  <p class="caption muted">Each marker is the city a station is based in. Stations reach well beyond it: search by ZIP code to see every station you can get.</p>
  <script type="application/json" data-map-info set:html={JSON.stringify(info)} />
</div>

<script>
  import { STATE_NAMES } from '../lib/states';

  type Kind = 'tv' | 'radio' | 'both';
  interface Info { name: string; kind: Kind; states: string[]; sub: string; meta: string; calls: string; apps: string[]; fallback: string | null; live: boolean; href: string }
  type Filter = 'all' | 'tv' | 'radio';
  interface Dot { el: SVGAElement; id: string; x: number; y: number; kind: Kind }
  interface Cluster { x: number; y: number; members: Dot[] }

  const W = 975, H = 610;
  const MAX_ZOOM = 32;
  const SVG_NS = 'http://www.w3.org/2000/svg';

  for (const root of document.querySelectorAll<HTMLElement>('[data-map]')) {
    const svg = root.querySelector('svg')!;
    const frame = root.querySelector<HTMLElement>('[data-frame]')!;
    const tip = root.querySelector<HTMLElement>('[data-map-tip]')!;
    const card = root.querySelector<HTMLElement>('[data-map-card]')!;
    const cardList = card.querySelector<HTMLUListElement>('[data-card-list]')!;
    const reset = root.querySelector<HTMLButtonElement>('[data-map-reset]')!;
    const resetIcon = root.querySelector<HTMLButtonElement>('[data-zoom="reset"]')!;
    const status = root.querySelector<HTMLElement>('[data-map-status]')!;
    const stateLink = root.querySelector<HTMLAnchorElement>('[data-map-state-link]')!;
    const clusterLayer = root.querySelector<SVGGElement>('[data-clusters]')!;
    const listPanel = root.querySelector<HTMLElement>('[data-list-panel]')!;
    const listHead = root.querySelector<HTMLElement>('[data-list-head]')!;
    const list = root.querySelector<HTMLUListElement>('[data-list]')!;
    const info = JSON.parse(root.querySelector('[data-map-info]')!.textContent!) as Record<string, Info>;
    const total = JSON.parse(root.dataset.total!) as Record<Filter, number>;
    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    const touch = matchMedia('(pointer: coarse)').matches || navigator.maxTouchPoints > 0;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dots: Dot[] = [...svg.querySelectorAll<SVGAElement>('.dots a')].map((el) => ({
      el, id: el.dataset.org!, x: Number(el.dataset.x), y: Number(el.dataset.y), kind: info[el.dataset.org!].kind,
    }));
    const dotById = new Map(dots.map((d) => [d.id, d]));
    let box = [0, 0, W, H];
    let filter: Filter = 'all';
    let activeState: SVGPathElement | null = null;
    let clusters: Cluster[] = [];
    let clusterOf = new Map<string, number>(); // dot id → index in clusters
    let shown: Element | null = null; // marker whose card is open
    let pinned: Element | null = null;
    let frameId = 0;
    let listTimer = 0;

    const zoom = () => W / box[2];
    const isZoomed = () => zoom() > 1.05;
    const noun = () => (filter === 'tv' ? 'TV station' : filter === 'radio' ? 'radio station' : 'station');
    const plural = (n: number) => `${n} ${noun()}${n === 1 ? '' : 's'}`;
    const passes = (d: Dot) => filter === 'all' || d.kind === 'both' || d.kind === filter;
    const inView = (d: { x: number; y: number }, pad = 0) =>
      d.x >= box[0] - pad && d.x <= box[0] + box[2] + pad && d.y >= box[1] - pad && d.y <= box[1] + box[3] + pad;

    // --- Grouping markers that would overlap -------------------------------------
    // Greedy, in screen space: each marker takes every not-yet-grouped marker within
    // `reach` of it. Uses a grid so it stays fast while zooming.
    const bubbleR = (n: number, dotPx: number) => dotPx * 1.6 + Math.min(7, Math.log2(n) * 2.2); // pixels
    const recluster = (unit: number, dotPx: number) => {
      const reach = (dotPx * 2 + 3) * unit; // map units
      const visible = dots.filter((d) => passes(d) && inView(d, reach * 2));
      const grid = new Map<string, Dot[]>();
      const cell = (x: number, y: number) => `${Math.floor(x / reach)},${Math.floor(y / reach)}`;
      for (const d of visible) grid.set(cell(d.x, d.y), [...(grid.get(cell(d.x, d.y)) ?? []), d]);
      const taken = new Set<string>();
      let groups: Dot[][] = [];
      for (const d of visible) {
        if (taken.has(d.id)) continue;
        const members: Dot[] = [];
        const cx = Math.floor(d.x / reach), cy = Math.floor(d.y / reach);
        for (let i = -1; i <= 1; i++) for (let j = -1; j <= 1; j++) {
          for (const o of grid.get(`${cx + i},${cy + j}`) ?? []) {
            if (!taken.has(o.id) && Math.hypot(o.x - d.x, o.y - d.y) < reach) { members.push(o); taken.add(o.id); }
          }
        }
        groups.push(members);
      }
      // Second pass: merge bubbles (and markers) that still overlap each other.
      const center = (g: Dot[]) => [g.reduce((s, m) => s + m.x, 0) / g.length, g.reduce((s, m) => s + m.y, 0) / g.length];
      const size = (g: Dot[]) => (g.length > 1 ? bubbleR(g.length, dotPx) : dotPx * 1.2) * unit;
      for (let merged = true; merged;) {
        merged = false;
        const cs = groups.map(center), rs = groups.map(size);
        outer: for (let a = 0; a < groups.length; a++) for (let b = a + 1; b < groups.length; b++) {
          if (Math.hypot(cs[a][0] - cs[b][0], cs[a][1] - cs[b][1]) < rs[a] + rs[b] + 2 * unit) {
            groups[a] = groups[a].concat(groups[b]);
            groups.splice(b, 1);
            merged = true;
            break outer;
          }
        }
      }
      clusters = [];
      clusterOf = new Map();
      for (const members of groups) {
        if (members.length < 2) continue;
        const [x, y] = center(members);
        const idx = clusters.push({ x, y, members }) - 1;
        for (const m of members) clusterOf.set(m.id, idx);
      }
      for (const d of dots) {
        d.el.classList.toggle('off', !passes(d));
        d.el.classList.toggle('grouped', clusterOf.has(d.id));
      }
      // Draw the bubbles: a number, and a ring split by the TV/radio mix.
      const frag = document.createDocumentFragment();
      clusters.forEach((c, i) => {
        const n = c.members.length;
        const r = bubbleR(n, dotPx) * unit;
        const tvShare = c.members.reduce((s, m) => s + (m.kind === 'tv' ? 1 : m.kind === 'both' ? 0.5 : 0), 0) / n;
        const g = document.createElementNS(SVG_NS, 'g');
        g.setAttribute('class', 'cluster');
        g.setAttribute('transform', `translate(${c.x} ${c.y})`);
        g.dataset.c = String(i);
        const ring = (cls: string, share: number, offset: number) => {
          const el = document.createElementNS(SVG_NS, 'circle');
          el.setAttribute('class', cls);
          el.setAttribute('r', String(r));
          el.setAttribute('pathLength', '100');
          el.setAttribute('stroke-width', String(3 * unit));
          el.setAttribute('stroke-dasharray', `${share * 100} ${100 - share * 100}`);
          el.setAttribute('stroke-dashoffset', String(-offset * 100 + 25));
          return el;
        };
        const bg = document.createElementNS(SVG_NS, 'circle');
        bg.setAttribute('class', 'c-bg');
        bg.setAttribute('r', String(r));
        const label = document.createElementNS(SVG_NS, 'text');
        label.setAttribute('font-size', String(Math.max(10, Math.min(13, r / unit)) * unit));
        label.setAttribute('dy', '0.35em');
        label.textContent = String(n);
        g.append(bg);
        if (tvShare > 0) g.append(ring('c-tv', tvShare, 0));
        if (tvShare < 1) g.append(ring('c-radio', 1 - tvShare, tvShare));
        g.append(label);
        frag.append(g);
      });
      clusterLayer.replaceChildren(frag);
      if (shown && !card.hidden) {
        // A station whose marker just joined a bubble: keep its card on the bubble.
        const target = markerFor(shown);
        if (target) place(card, target); else hideCard();
      }
    };

    // --- View box: clamp, draw, animate --------------------------------------------
    const clamp = (b: number[]) => {
      const w = Math.min(W, Math.max(W / MAX_ZOOM, b[2]));
      const h = w * H / W;
      const cx = b[0] + b[2] / 2, cy = b[1] + b[3] / 2;
      const x = Math.min(W - w / 2, Math.max(w / 2, cx)) - w / 2;
      const y = Math.min(H - h / 2, Math.max(h / 2, cy)) - h / 2;
      return [x, y, w, h];
    };
    const draw = () => {
      svg.setAttribute('viewBox', box.join(' '));
      const z = zoom();
      svg.classList.toggle('zoomed', isZoomed());
      reset.hidden = !isZoomed();
      resetIcon.hidden = !isZoomed();
      // Markers stay a tappable size on screen, growing a little as you zoom in.
      const unit = box[2] / (svg.getBoundingClientRect().width || W); // map units per pixel
      const basePx = innerWidth < 700 ? 3.4 : 4.4;
      const dotPx = Math.min(8, basePx * Math.sqrt(z));
      svg.style.setProperty('--dot-r', String(dotPx * unit));
      svg.style.setProperty('--stroke', String(unit));
      recluster(unit, dotPx);
      clearTimeout(listTimer);
      listTimer = window.setTimeout(updateList, 120);
    };
    const setBox = (target: number[], animate = false) => {
      target = clamp(target);
      if (W / target[2] <= 1.05 && activeState) clearState(); // back to the whole country
      cancelAnimationFrame(frameId);
      tip.hidden = true;
      if (!animate || reduceMotion) { box = target; draw(); return; }
      const from = box.slice();
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / 380);
        const e = 1 - (1 - t) ** 3;
        box = from.map((v, i) => v + (target[i] - v) * e);
        draw();
        if (t < 1) frameId = requestAnimationFrame(step);
      };
      frameId = requestAnimationFrame(step);
    };
    // Zoom by `factor` keeping the map point (px, py) under the same spot on screen.
    const zoomAt = (factor: number, px = box[0] + box[2] / 2, py = box[1] + box[3] / 2, animate = false) => {
      setBox([px - (px - box[0]) / factor, py - (py - box[1]) / factor, box[2] / factor, box[3] / factor], animate);
    };
    // Zoom in on a bubble just far enough for its markers to separate, keeping them
    // all in view where possible.
    const fitGroup = (pts: Dot[]) => {
      const xs = pts.map((p) => p.x), ys = pts.map((p) => p.y);
      const x0 = Math.min(...xs), x1 = Math.max(...xs), y0 = Math.min(...ys), y1 = Math.max(...ys);
      let closest = Infinity;
      for (let a = 0; a < pts.length; a++) for (let b = a + 1; b < pts.length; b++) closest = Math.min(closest, Math.hypot(pts[a].x - pts[b].x, pts[a].y - pts[b].y));
      const screenW = svg.getBoundingClientRect().width || W;
      const separate = (closest * screenW) / 26; // 26px apart on screen is enough to pick each one
      const spread = Math.max((x1 - x0) * 1.4, (y1 - y0) * 1.4 * W / H);
      const w = Math.min(box[2] / 2, Math.max(separate, spread));
      const h = w * H / W;
      setBox([(x0 + x1) / 2 - w / 2, (y0 + y1) / 2 - h / 2, w, h], true);
    };
    const toMap = (clientX: number, clientY: number) => {
      const r = svg.getBoundingClientRect();
      return [box[0] + ((clientX - r.left) / r.width) * box[2], box[1] + ((clientY - r.top) / r.height) * box[3]];
    };
    const zoomOutAll = () => { hideCard(); clearState(); setBox([0, 0, W, H], true); };

    // --- Filter: all / TV / radio ----------------------------------------------------
    for (const b of root.querySelectorAll<HTMLButtonElement>('[data-filter]')) {
      b.addEventListener('click', () => {
        filter = b.dataset.filter as Filter;
        for (const o of root.querySelectorAll('[data-filter]')) o.setAttribute('aria-pressed', String(o === b));
        hideCard();
        draw();
        updateStatus();
      });
    }
    function updateStatus() {
      if (activeState) {
        const n = Number(activeState.dataset[filter]);
        status.textContent = `${STATE_NAMES[activeState.dataset.state!] ?? activeState.dataset.name}: ${plural(n)}. ${touch ? 'Tap' : 'Pick'} a marker or a name in the list to learn more.`;
      } else {
        status.textContent = `${plural(total[filter])} on the map. ${touch ? 'Tap a state or pinch to zoom in.' : 'Pick a state or zoom in.'} Numbered bubbles are several stations: ${touch ? 'tap' : 'click'} one to zoom in.`;
      }
    }

    // --- The list of stations in view ----------------------------------------------
    let listHl: Element | null = null;
    // A picked state lists that state's stations; otherwise, whatever is in view.
    function updateList() {
      const code = activeState?.dataset.state;
      const visible = dots
        .filter((d) => passes(d) && (code ? info[d.id].states.includes(code) : inView(d)))
        .sort((a, b) => info[a.id].name.localeCompare(info[b.id].name));
      if (!isZoomed() && !activeState) {
        listPanel.hidden = false;
        listHead.textContent = 'Stations in view';
        const li = document.createElement('li');
        li.className = 'list-note';
        li.textContent = `Pick a state or zoom in to list the stations there.`;
        list.replaceChildren(li);
        return;
      }
      listPanel.hidden = false;
      listHead.textContent = code ? `${plural(visible.length)} in ${STATE_NAMES[code] ?? code}` : `${plural(visible.length)} in view`;
      const items = visible.map((d) => {
        const i = info[d.id];
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = i.href;
        a.dataset.org = d.id;
        const key = document.createElement('span');
        key.className = `key ${d.kind}`;
        key.setAttribute('aria-hidden', 'true');
        const text = document.createElement('span');
        text.className = 'list-text';
        const name = document.createElement('span');
        name.className = 'list-name';
        name.textContent = i.name;
        const sub = document.createElement('span');
        sub.className = 'list-sub';
        sub.textContent = i.sub;
        text.append(name, sub);
        a.append(key, text);
        li.append(a);
        return li;
      });
      if (!items.length) {
        const li = document.createElement('li');
        li.className = 'list-note';
        li.textContent = 'No stations in this part of the map.';
        items.push(li);
      }
      list.replaceChildren(...items);
    }
    const pointTo = (id: string | null) => {
      listHl?.classList.remove('hl');
      listHl = null;
      if (!id) return;
      const d = dotById.get(id)!;
      const idx = clusterOf.get(id);
      listHl = idx !== undefined ? clusterLayer.querySelector(`[data-c="${idx}"]`) : d.el;
      listHl?.classList.add('hl');
    };
    list.addEventListener('pointerover', (e) => pointTo((e.target as Element).closest<HTMLElement>('a[data-org]')?.dataset.org ?? null));
    list.addEventListener('pointerleave', () => pointTo(null));
    list.addEventListener('focusin', (e) => pointTo((e.target as Element).closest<HTMLElement>('a[data-org]')?.dataset.org ?? null));
    list.addEventListener('focusout', () => pointTo(null));

    // --- Positioning helpers -----------------------------------------------------
    // The element a card should point at: the station's marker, or its bubble.
    function markerFor(el: Element): Element | null {
      if (el.classList.contains('cluster')) return el.isConnected ? el : null;
      const id = (el as SVGAElement).dataset.org!;
      const idx = clusterOf.get(id);
      if (idx !== undefined) return clusterLayer.querySelector(`[data-c="${idx}"]`);
      return el.classList.contains('off') ? null : el.querySelector('.shape');
    }
    function place(el: HTMLElement, target: Element) {
      const r = target.getBoundingClientRect();
      const f = frame.getBoundingClientRect();
      const x = r.left - f.left + r.width / 2;
      const y = r.top - f.top;
      el.style.left = `${x}px`;
      el.style.top = `${y}px`;
      // Keep the popup inside the map: flip below the marker near the top edge,
      // and nudge sideways near the left/right edges.
      el.classList.toggle('below', y < el.offsetHeight + 16);
      const half = el.offsetWidth / 2;
      el.style.setProperty('--shift', `${Math.max(8 + half - x, Math.min(0, f.width - 8 - half - x))}px`);
    }

    // --- Cards -------------------------------------------------------------------
    const q = <T extends Element>(s: string) => card.querySelector<T>(s)!;
    const fillStation = (id: string) => {
      const i = info[id];
      q('[data-card-name]').textContent = i.name;
      q('[data-card-meta]').textContent = [i.meta, i.calls].filter(Boolean).join(' · ');
      q<HTMLElement>('[data-card-apps]').hidden = false;
      q('[data-card-apps]').textContent = i.apps.length
        ? `Own apps: ${i.apps.join(', ')}`
        : i.fallback ?? '';
      q<HTMLElement>('[data-card-live]').hidden = !i.live;
      cardList.hidden = true;
      const link = q<HTMLAnchorElement>('[data-card-link]');
      link.hidden = false;
      link.href = i.href;
    };
    // Stations too close to separate even at full zoom (e.g. one building, two stations).
    const fillGroup = (members: Dot[]) => {
      q('[data-card-name]').textContent = `${members.length} stations here`;
      q('[data-card-meta]').textContent = '';
      q<HTMLElement>('[data-card-apps]').hidden = true;
      q<HTMLElement>('[data-card-live]').hidden = true;
      q<HTMLElement>('[data-card-link]').hidden = true;
      cardList.replaceChildren(...members.map((m) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = info[m.id].href;
        a.innerHTML = `<span class="key ${m.kind}" aria-hidden="true"></span>`;
        a.append(info[m.id].name);
        li.append(a);
        return li;
      }));
      cardList.hidden = false;
    };
    const showCard = (el: Element, pin: boolean) => {
      tip.hidden = true;
      if (el.classList.contains('cluster')) fillGroup(clusters[Number((el as SVGGElement).dataset.c)].members);
      else fillStation((el as SVGAElement).dataset.org!);
      card.hidden = false;
      card.classList.toggle('pinned', pin);
      shown?.classList.remove('hl');
      shown = el;
      el.classList.add('hl');
      const target = markerFor(el);
      if (target) place(card, target);
      pinned = pin ? el : pinned;
    };
    function hideCard() {
      card.hidden = true;
      pinned = null;
      shown?.classList.remove('hl');
      shown = null;
    }

    // --- States and bubbles ------------------------------------------------------
    function clearState() {
      activeState?.classList.remove('active');
      activeState = null;
      stateLink.hidden = true;
      updateStatus();
      updateList();
    }
    const zoomToState = (state: SVGPathElement) => {
      const [x, y, w, h] = state.dataset.box!.split(' ').map(Number);
      const pad = Math.max(w, h) * 0.15;
      let bw = w + 2 * pad, bh = h + 2 * pad;
      if (bw / bh > W / H) bh = bw * H / W; else bw = bh * W / H;
      activeState?.classList.remove('active');
      activeState = state;
      state.classList.add('active');
      setBox([x + w / 2 - bw / 2, y + h / 2 - bh / 2, bw, bh], true);
      const code = state.dataset.state!;
      const name = STATE_NAMES[code] ?? state.dataset.name;
      stateLink.hidden = !code;
      stateLink.href = `${base}/state/${code.toLowerCase()}/`;
      stateLink.textContent = `See every station in ${name} →`;
      updateStatus();
    };
    const openCluster = (g: SVGGElement) => {
      const c = clusters[Number(g.dataset.c)];
      if (zoom() >= MAX_ZOOM * 0.95) { showCard(g, true); return; }
      hideCard();
      fitGroup(c.members);
    };

    // --- Hover (mouse) -----------------------------------------------------------
    svg.addEventListener('pointerover', (e) => {
      if (e.pointerType !== 'mouse' || dragging) return;
      const t = e.target as Element;
      const dot = t.closest<SVGAElement>('.dots a');
      const group = t.closest<SVGGElement>('.cluster');
      const state = t.closest<SVGPathElement>('path[data-state]');
      if (pinned) return;
      if (dot) showCard(dot, false);
      else if (group) {
        const c = clusters[Number(group.dataset.c)];
        const names = c.members.map((m) => info[m.id].name);
        tip.textContent = `${names.slice(0, 3).join(', ')}${names.length > 3 ? ` + ${names.length - 3} more` : ''} · click to zoom in`;
        tip.hidden = false;
      } else if (state) {
        tip.textContent = `${STATE_NAMES[state.dataset.state!] ?? state.dataset.name} · ${plural(Number(state.dataset[filter]))}`;
        tip.hidden = false;
      }
    });
    svg.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || tip.hidden) return;
      const f = frame.getBoundingClientRect();
      tip.style.left = `${e.clientX - f.left}px`;
      tip.style.top = `${e.clientY - f.top - 6}px`;
      tip.style.setProperty('--shift', '0px');
    });
    svg.addEventListener('pointerout', (e) => {
      if (e.pointerType !== 'mouse') return;
      const to = e.relatedTarget as Element | null;
      if (to && (card.contains(to) || to.closest?.('.dots a'))) return;
      tip.hidden = true;
      if (!pinned) hideCard();
    });
    card.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse' && !pinned) hideCard();
    });

    // --- Drag to pan, pinch to zoom (mouse, pen, and touch) -----------------------
    const pointers = new Map<number, { x: number; y: number }>();
    let dragging = false; // moved far enough that the gesture isn't a click
    let startDist = 0, startBox = box, startMid = [0, 0];
    const mid = () => { const [a, b] = [...pointers.values()]; return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2, d: Math.hypot(a.x - b.x, a.y - b.y) }; };
    let lastPointer = '';
    svg.addEventListener('pointerdown', (e) => {
      lastPointer = e.pointerType;
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      dragging = false;
      startBox = box.slice();
      if (pointers.size === 2) {
        const m = mid();
        startDist = m.d;
        startMid = toMap(m.x, m.y);
      }
    });
    svg.addEventListener('pointermove', (e) => {
      const p = pointers.get(e.pointerId);
      if (!p) return;
      const r = svg.getBoundingClientRect();
      const unit = box[2] / r.width;
      if (pointers.size === 1) {
        const dx = e.clientX - p.x, dy = e.clientY - p.y;
        if (!dragging && Math.hypot(dx, dy) < 6) return;
        if (!isZoomed()) return; // nothing to pan when showing the whole country
        if (!dragging) { dragging = true; tip.hidden = true; svg.setPointerCapture(e.pointerId); svg.classList.add('panning'); }
        p.x = e.clientX; p.y = e.clientY;
        setBox([box[0] - dx * unit, box[1] - dy * unit, box[2], box[3]]);
      } else if (pointers.size === 2) {
        p.x = e.clientX; p.y = e.clientY;
        dragging = true;
        const m = mid();
        const factor = Math.max(0.05, m.d / (startDist || 1));
        const w = startBox[2] / factor, h = startBox[3] / factor;
        // Keep the point between the fingers under the fingers.
        const fx = (m.x - r.left) / r.width, fy = (m.y - r.top) / r.height;
        setBox([startMid[0] - fx * w, startMid[1] - fy * h, w, h]);
      }
    });
    const endPointer = (e: PointerEvent) => {
      pointers.delete(e.pointerId);
      svg.classList.remove('panning');
      if (pointers.size === 1) startBox = box.slice();
    };
    svg.addEventListener('pointerup', endPointer);
    svg.addEventListener('pointercancel', endPointer);

    // Trackpad pinch and ctrl/⌘ + scroll zoom. A plain scroll wheel keeps scrolling the
    // page until you've zoomed in, so the map never traps someone scrolling past it.
    svg.addEventListener('wheel', (e) => {
      if (!(e.ctrlKey || e.metaKey) && !isZoomed()) return;
      e.preventDefault();
      const [px, py] = toMap(e.clientX, e.clientY);
      zoomAt(Math.exp(-e.deltaY * (e.ctrlKey ? 0.01 : 0.002)), px, py);
    }, { passive: false });
    svg.addEventListener('dblclick', (e) => {
      e.preventDefault();
      const [px, py] = toMap(e.clientX, e.clientY);
      zoomAt(2, px, py, true);
    });

    // --- Keyboard ----------------------------------------------------------------
    svg.addEventListener('focusin', (e) => {
      const dot = (e.target as Element).closest<SVGAElement>('.dots a');
      if (dot) showCard(dot, false);
    });
    svg.addEventListener('keydown', (e) => {
      const group = (e.target as Element).closest<SVGGElement>('.cluster');
      if (group && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); openCluster(group); }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (!card.hidden) hideCard();
      else if (isZoomed() && root.contains(document.activeElement)) zoomOutAll();
    });

    // --- Click / tap -------------------------------------------------------------
    svg.addEventListener('click', (e) => {
      if (dragging) { e.preventDefault(); dragging = false; return; } // end of a drag or pinch
      const t = e.target as Element;
      const dot = t.closest<SVGAElement>('.dots a');
      if (dot) {
        // With a mouse, hovering already shows the card, so a click opens the station.
        // On touch screens there's no hover: the first tap shows the card (its button
        // opens the station), and tapping the same marker again opens it too.
        if (lastPointer === 'mouse' || pinned === dot) return;
        e.preventDefault();
        showCard(dot, true);
        return;
      }
      const group = t.closest<SVGGElement>('.cluster');
      if (group) { openCluster(group); return; }
      if (pinned) { hideCard(); return; }
      const state = t.closest<SVGPathElement>('path[data-state]');
      // Clicking outside the states zooms back out.
      if (!state) { if (isZoomed()) zoomOutAll(); return; }
      if (state !== activeState) zoomToState(state);
    });
    card.querySelector('[data-card-close]')!.addEventListener('click', hideCard);
    document.addEventListener('click', (e) => { if (pinned && !root.contains(e.target as Node)) hideCard(); });

    for (const b of root.querySelectorAll<HTMLButtonElement>('[data-zoom]')) {
      b.addEventListener('click', () => {
        hideCard();
        if (b.dataset.zoom === 'in') zoomAt(2, undefined, undefined, true);
        else if (b.dataset.zoom === 'out') zoomAt(0.5, undefined, undefined, true);
        else zoomOutAll();
      });
    }
    reset.addEventListener('click', zoomOutAll);
    addEventListener('resize', () => { hideCard(); draw(); });
    updateStatus();
    draw();
  }
</script>

<style>
  .station-map { display: flex; flex-direction: column; gap: var(--space-12); }
  .map-bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-12); }
  .filters { display: inline-flex; padding: 4px; gap: 4px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-full); }
  .filter {
    display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 var(--space-12);
    border: 0; border-radius: var(--radius-full); background: none; color: var(--text); font: inherit; font-weight: 600; font-size: 14px; cursor: pointer;
  }
  .filter:hover { background: var(--bg); }
  .filter[aria-pressed='true'] { background: var(--bg); box-shadow: 0 1px 3px rgb(0 0 0 / 0.15); }
  .filter .n { color: var(--text-muted); font-weight: 500; font-variant-numeric: tabular-nums; }
  .legend { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-16); margin: 0; }
  .legend > span { display: inline-flex; align-items: center; gap: 6px; }

  /* Legend and list swatches: the same shapes as the markers. */
  .key, :global(.key) { display: inline-block; width: 10px; height: 10px; flex: none; border-radius: 3px; background: var(--accent); }
  .key.radio, :global(.key.radio) { border-radius: 50%; background: var(--warm); }
  .key.both, :global(.key.both) { background: linear-gradient(90deg, var(--accent) 50%, var(--warm) 50%); }
  .key.group {
    width: 18px; height: 18px; border-radius: 50%; display: inline-grid; place-items: center;
    background: var(--surface-raised); color: var(--text); font-size: 10px; font-weight: 700; line-height: 1;
    border: 2px solid var(--accent); border-bottom-color: var(--warm); border-left-color: var(--warm);
  }

  .map-layout { display: grid; gap: var(--space-16); }
  @media (min-width: 1000px) {
    .map-layout { grid-template-columns: minmax(0, 1fr) 280px; align-items: start; }
    .map-list { position: relative; align-self: stretch; }
    .map-list ul { position: absolute; inset: 40px 0 0; }
  }
  .map-col { display: flex; flex-direction: column; gap: var(--space-12); min-width: 0; }
  .map-frame { position: relative; }
  svg { width: 100%; height: auto; display: block; border-radius: var(--radius-md); touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  svg.zoomed { touch-action: none; cursor: grab; }
  svg.panning { cursor: grabbing; }

  .states path { fill: var(--surface); stroke: none; cursor: pointer; transition: fill 0.15s; }
  .states path:hover { fill: var(--accent-subtle); }
  .states path.active { fill: var(--accent-subtle); }
  .borders { fill: none; stroke: var(--border); stroke-width: var(--stroke, 1); stroke-linejoin: round; pointer-events: none; }

  /* Markers are drawn at unit size and scaled so they stay the same size on screen. */
  .dot .m { transform: scale(var(--dot-r, 4)); }
  .dot .hit { fill: transparent; }
  .dot .shape { fill: var(--accent); stroke: var(--bg); stroke-width: 1.25px; vector-effect: non-scaling-stroke; }
  .dot.radio .shape { fill: var(--warm); }
  .dot.both .shape { fill: url(#map-split); }
  .stop-tv { stop-color: var(--accent); }
  .stop-radio { stop-color: var(--warm); }
  .dot { cursor: pointer; }
  .dot:hover .m, .dot:focus-visible .m, .dot.hl .m { transform: scale(calc(var(--dot-r, 4) * 1.55)); }
  .dot.hl .shape, .dot:focus-visible .shape { stroke: var(--text); stroke-width: 2px; }
  .dot:focus-visible { outline: none; }
  .dot.off, .dot.grouped { display: none; }

  :global(.cluster) { cursor: pointer; }
  :global(.cluster) :global(.c-bg) { fill: var(--surface-raised); stroke: var(--bg); stroke-width: 1px; vector-effect: non-scaling-stroke; }
  :global(.cluster) :global(.c-tv), :global(.cluster) :global(.c-radio) { fill: none; }
  :global(.cluster) :global(.c-tv) { stroke: var(--accent); }
  :global(.cluster) :global(.c-radio) { stroke: var(--warm); }
  :global(.cluster) :global(text) { fill: var(--text); font-weight: 700; text-anchor: middle; pointer-events: none; font-variant-numeric: tabular-nums; }
  :global(.cluster:hover) :global(.c-bg), :global(.cluster.hl) :global(.c-bg), :global(.cluster:focus-visible) :global(.c-bg) { fill: var(--accent-subtle); }
  :global(.cluster:focus-visible) { outline: none; }
  /* On touch screens, the zoomed-out map is for picking a state: taps go to the state. */
  @media (pointer: coarse) { svg:not(.zoomed) .dots, svg:not(.zoomed) .clusters { pointer-events: none; } }

  .map-list { display: flex; flex-direction: column; gap: var(--space-8); min-width: 0; }
  .list-head { margin: 0; min-height: 32px; display: flex; align-items: center; }
  .map-list ul {
    list-style: none; margin: 0; padding: var(--space-4); overflow-y: auto; max-height: 420px;
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md);
  }
  @media (min-width: 1000px) { .map-list ul { max-height: none; } }
  .map-list :global(a) { display: flex; align-items: center; gap: var(--space-12); padding: var(--space-8); border-radius: var(--radius-sm); color: var(--text); text-decoration: none; }
  .map-list :global(a):hover, .map-list :global(a):focus-visible { background: var(--bg); }
  :global(.list-text) { display: flex; flex-direction: column; min-width: 0; }
  :global(.list-name) { font-weight: 600; font-size: 15px; line-height: 1.3; }
  :global(.list-sub) { color: var(--text-muted); font-size: 13px; }
  :global(.list-note) { padding: var(--space-12); color: var(--text-muted); font-size: 14px; }

  .zoom-controls {
    position: absolute; top: var(--space-8); right: var(--space-8); z-index: 1;
    display: flex; flex-direction: column; gap: 1px; border-radius: var(--radius-sm); overflow: hidden;
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.2); background: var(--border);
  }
  .zoom-btn {
    width: 40px; height: 40px; display: grid; place-items: center; border: 0; padding: 0;
    background: var(--surface-raised); color: var(--text); font: inherit; font-size: 22px; font-weight: 600; line-height: 1; cursor: pointer;
  }
  .zoom-btn[hidden] { display: none; }
  .zoom-btn:hover { background: var(--surface); }
  .zoom-btn :global(svg) { width: 20px; height: 20px; }
  .map-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-12); }
  .map-foot:has(> [hidden] + [hidden]) { display: none; }

  .map-tip, .map-card {
    position: absolute; transform: translate(calc(-50% + var(--shift, 0px)), calc(-100% - 12px)); z-index: 2;
  }
  .map-tip.below, .map-card.below { transform: translate(calc(-50% + var(--shift, 0px)), 24px); }
  .map-tip {
    pointer-events: none; background: var(--text); color: var(--bg); padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-sm); white-space: nowrap; max-width: 90%; overflow: hidden; text-overflow: ellipsis;
  }
  .map-card {
    width: min(300px, calc(100vw - 48px)); background: var(--surface-raised); color: var(--text);
    border: 1px solid var(--border); border-radius: var(--radius-md); padding: var(--space-16);
    display: flex; flex-direction: column; gap: var(--space-8); align-items: flex-start;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.18);
  }
  .map-card .h3 { padding-right: var(--space-24); }
  .map-card .btn { margin-top: var(--space-4); padding: var(--space-8) var(--space-12); }
  .map-card [hidden] { display: none; }
  .card-list { list-style: none; margin: 0; padding: 0; width: 100%; }
  .card-list :global(a) { display: flex; align-items: center; gap: var(--space-8); padding: var(--space-8) 0; font-weight: 600; }
  .card-close {
    position: absolute; top: var(--space-4); right: var(--space-4); width: 32px; height: 32px;
    border: 0; background: none; color: var(--text-muted); font-size: 22px; line-height: 1; cursor: pointer; border-radius: var(--radius-sm);
  }
  .card-close:hover { background: var(--surface); }
  .map-card:not(.pinned) .card-close { display: none; }
  .live-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #d93025; margin-right: var(--space-8); vertical-align: middle; }
  /* Phones: the map is small, so the buttons sit in a row under it instead of on top. */
  @media (max-width: 700px) {
    .zoom-controls { position: static; flex-direction: row; justify-content: flex-end; gap: var(--space-8); margin-top: var(--space-8); background: none; box-shadow: none; overflow: visible; }
    .zoom-btn { width: 44px; height: 44px; border: 1px solid var(--border); border-radius: var(--radius-sm); }
    .zoom-btn[data-zoom='reset'] { display: none; } /* "Zoom out to all of the US" is right below */
    /* The station card sits under the map, so it never covers the markers. */
    .map-card, .map-card.below { position: relative; left: auto !important; top: auto !important; transform: none; width: auto; margin-top: var(--space-8); }
  }
</style>
