---
// The one search box: ZIP, city/state, station name, or call letters. Submits to /search
// (a plain GET form, so it works without JavaScript).
import Icon from './Icon.astro';
import { url } from '../lib/site';

interface Props { value?: string; id?: string }
const { value = '', id = 'q' } = Astro.props;
---
<form class="search-form" action={url('/search/')} method="get" role="search">
  <label for={id} class="visually-hidden">ZIP code, city, station name, or call letters</label>
  <div class="search-input">
    <Icon name="search" />
    <input id={id} name="q" type="search" value={value} required autocomplete="postal-code"
      placeholder="ZIP, city, or station name" enterkeyhint="search" />
  </div>
  <button class="btn btn-primary" type="submit">Find my stations</button>
</form>

<style>
  .search-form { display: flex; flex-direction: column; gap: var(--space-12); }
  @media (min-width: 701px) { .search-form { flex-direction: row; } }
  .search-input {
    flex: 1; display: flex; align-items: center; gap: var(--space-12);
    padding: 0 var(--space-16); border: 2px solid var(--text); border-radius: var(--radius-md);
    background: var(--surface-raised);
  }
  .search-input:focus-within { outline: 3px solid var(--accent); outline-offset: 2px; }
  .search-input svg { width: 24px; height: 24px; color: var(--text-muted); flex: none; }
  input {
    flex: 1; min-width: 0; border: 0; background: none; color: var(--text);
    font: inherit; padding: var(--space-16) 0; outline: none;
  }
  input::placeholder { color: var(--text-muted); opacity: 1; }
  .btn { padding: var(--space-16) var(--space-24); }
</style>
