---
// Decorative US outline with one dot per transmitter, drawn at build time (no requests).
// Used on the homepage. Every dot is identical.
//
// With `live`, stations take turns "going on air": a soft ripple spreads from where a
// station is based, and every few seconds a small tag on the map names one (TV, radio,
// or both), linked to its page. Stations are picked at random, so every station is
// equally likely. Nothing moves for people who ask for reduced motion (one station is
// named instead), and it pauses when off screen.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { feature } from 'topojson-client';
import { geoAlbersUsa, geoPath } from 'd3-geo';
import type { Topology, GeometryCollection } from 'topojson-specification';
import { facilities, organizations } from '../lib/data';
import { url } from '../lib/site';

interface Props { class?: string; dotRadius?: number; live?: boolean }
const { class: className, dotRadius = 3.2, live = false } = Astro.props;

const topo = JSON.parse(readFileSync(join(process.cwd(), 'node_modules', 'us-atlas', 'nation-albers-10m.json'), 'utf8')) as Topology;
const nation = path(feature(topo, topo.objects.nation as GeometryCollection));
function path(f: Parameters<ReturnType<typeof geoPath>>[0]) { return geoPath().digits(0)(f) ?? ''; }
const projection = geoAlbersUsa().scale(1300).translate([487.5, 305]);
const dots = facilities.flatMap((f) => {
  const p = projection([f.lng, f.lat]);
  return p ? [{ x: Math.round(p[0]), y: Math.round(p[1]), radio: f.service !== 'tv' }] : [];
});
// [x, y, kind (0 TV, 1 radio, 2 both), name, "City, ST", link] for each station on the map.
const stations = live
  ? organizations.flatMap((o) => {
      const p = o.home && projection([o.home.lng, o.home.lat]);
      if (!p || !o.home) return [];
      const kind = o.mediaTypes.includes('tv') ? (o.mediaTypes.includes('radio') ? 2 : 0) : 1;
      return [[Math.round(p[0]), Math.round(p[1]), kind, o.name, o.home.city ? `${o.home.city}, ${o.state}` : o.state, url(`/station/${o.id}/`)]];
    })
  : [];
---
{live ? (
  <div class:list={['live-map', className]} data-live={JSON.stringify(stations)}>
    <svg class="dot-map" viewBox="0 0 975 610" aria-hidden="true" focusable="false">
      <path class="land" d={nation} />
      {dots.map((d) => <circle class:list={[d.radio && 'radio']} cx={d.x} cy={d.y} r={dotRadius} />)}
      <g class="ripples" data-ripples></g>
    </svg>
    <a class="on-air-tag" data-on-air-tag href="#" tabindex="-1" aria-hidden="true" hidden>
      <span class="kind" data-kind></span>
      <span class="who"><span class="name" data-name></span><span class="place" data-place></span></span>
    </a>
  </div>
) : (
  <svg class:list={['dot-map', className]} viewBox="0 0 975 610" aria-hidden="true" focusable="false">
    <path class="land" d={nation} />
    {dots.map((d) => <circle class:list={[d.radio && 'radio']} cx={d.x} cy={d.y} r={dotRadius} />)}
  </svg>
)}

<script>
  type Station = [number, number, 0 | 1 | 2, string, string, string];
  const SVG_NS = 'http://www.w3.org/2000/svg';
  const KIND = ['TV', 'Radio', 'TV & radio'];
  const NAMED_EVERY = 6000; // ms between named stations
  const RIPPLE_EVERY = 1500; // ms between quiet background ripples
  const still = matchMedia('(prefers-reduced-motion: reduce)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-live]')) {
    const stations = JSON.parse(root.dataset.live!) as Station[];
    const svg = root.querySelector('svg')!;
    const layer = root.querySelector<SVGGElement>('[data-ripples]')!;
    const tag = root.querySelector<HTMLAnchorElement>('[data-on-air-tag]')!;
    const pick = () => stations[Math.floor(Math.random() * stations.length)];

    const ripple = (s: Station, named: boolean) => {
      const g = document.createElementNS(SVG_NS, 'g');
      g.setAttribute('class', `ripple k${s[2]}${named ? ' named' : ''}`);
      g.setAttribute('transform', `translate(${s[0]} ${s[1]})`);
      for (const delay of named ? [0, 0.7] : [0]) {
        const c = document.createElementNS(SVG_NS, 'circle');
        c.setAttribute('r', named ? '30' : '20');
        c.style.animationDelay = `${delay}s`;
        g.append(c);
      }
      if (named) {
        const dot = document.createElementNS(SVG_NS, 'circle');
        dot.setAttribute('class', 'core');
        dot.setAttribute('r', '5');
        g.append(dot);
      }
      layer.append(g);
      setTimeout(() => g.remove(), named ? NAMED_EVERY : 3200);
    };

    // The tag sits just above the station's dot, kept inside the map's edges.
    const showTag = (s: Station) => {
      tag.classList.remove('show');
      setTimeout(() => {
        tag.href = s[5];
        tag.dataset.k = String(s[2]);
        tag.querySelector('[data-kind]')!.textContent = KIND[s[2]];
        tag.querySelector('[data-name]')!.textContent = s[3];
        tag.querySelector('[data-place]')!.textContent = s[4];
        tag.hidden = false;
        const w = svg.clientWidth, h = svg.clientHeight;
        const x = (s[0] / 975) * w, y = (s[1] / 610) * h;
        const half = tag.offsetWidth / 2;
        const left = Math.min(Math.max(x, half + 4), w - half - 4);
        const above = y - tag.offsetHeight - 14;
        tag.style.left = `${left}px`;
        tag.style.top = `${above >= 0 ? above : y + 14}px`;
        tag.classList.add('show');
      }, tag.hidden ? 0 : 300);
    };

    if (still.matches) { showTag(pick()); continue; }

    let visible = true;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(root);
    const active = () => visible && !document.hidden;
    const named = () => { if (!active()) return; const s = pick(); ripple(s, true); showTag(s); };
    named();
    setInterval(named, NAMED_EVERY);
    setInterval(() => { if (active()) ripple(pick(), false); }, RIPPLE_EVERY);
  }
</script>

<style>
  .dot-map { width: 100%; height: auto; display: block; }
  .land { fill: color-mix(in srgb, var(--accent) 7%, transparent); stroke: color-mix(in srgb, var(--accent) 18%, transparent); stroke-width: 1.2; }
  circle { fill: var(--tv); opacity: 0.55; }
  circle.radio { fill: var(--radio); }

  /* Live map: ripples and the station tag. TV is blue, radio orange. */
  .live-map { position: relative; }
  .live-map :global(.ripple circle) {
    fill: none; stroke: var(--tv); stroke-width: 2; opacity: 0;
    transform-box: fill-box; transform-origin: center;
    animation: ripple 3s cubic-bezier(0.2, 0.6, 0.3, 1) forwards;
  }
  .live-map :global(.ripple.k1 circle) { stroke: var(--radio); }
  .live-map :global(.ripple.named circle) { stroke-width: 2.5; animation-duration: 3.6s; }
  .live-map :global(.ripple .core) { fill: var(--tv); stroke: var(--bg); stroke-width: 1.5; opacity: 1; animation: core 5.6s ease-out forwards; }
  .live-map :global(.ripple.k1 .core) { fill: var(--radio); }
  .live-map :global(.ripple.k2 .core) { fill: var(--radio); stroke: var(--tv); stroke-width: 2.5; }
  @keyframes ripple { 0% { transform: scale(0.15); opacity: 0.85; } 100% { transform: scale(1); opacity: 0; } }
  @keyframes core { 0%, 85% { opacity: 1; } 100% { opacity: 0; } }

  .on-air-tag {
    position: absolute; transform: translateX(-50%); z-index: 1;
    display: inline-flex; align-items: center; gap: var(--space-8); max-width: min(340px, 92%);
    padding: 6px 12px 6px 6px; border-radius: var(--radius-full);
    background: var(--surface-raised); border: 1px solid var(--border); box-shadow: var(--shadow-md);
    color: var(--text); text-decoration: none; font-size: 14px; line-height: 1.25;
    opacity: 0; transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .on-air-tag.show { opacity: 1; }
  .on-air-tag:hover .name { text-decoration: underline; }
  .on-air-tag .kind {
    flex: none; display: inline-flex; align-items: center; gap: 6px; padding: 2px 8px; border-radius: var(--radius-full);
    font-size: 12px; font-weight: 700; color: var(--text); background: var(--surface); border: 1px solid var(--border);
  }
  .on-air-tag .kind::before { content: ''; width: 8px; height: 8px; border-radius: 2px; background: var(--tv); }
  .on-air-tag[data-k='1'] .kind::before { border-radius: 50%; background: var(--radio); }
  .on-air-tag[data-k='2'] .kind::before { background: linear-gradient(90deg, var(--tv) 50%, var(--radio) 50%); }
  .on-air-tag .who { display: flex; flex-direction: column; min-width: 0; }
  .on-air-tag .name { font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .on-air-tag .place { color: var(--text-muted); font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
</style>
