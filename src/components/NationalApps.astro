---
// Fallback shown only on the page of a station with no apps of its own (station first:
// we never advertise the national apps next to a station's own). PBS and NPR only, names as text, no logos,
// no PBS KIDS. Each button points at the web version by default; the device script swaps
// in the App Store or Google Play link for phone visitors.
import Icon from './Icon.astro';
import { national } from '../lib/data';

const DESCRIPTIONS: Record<string, string> = {
  pbs: 'Shows, documentaries, and many local livestreams',
  npr: 'News, podcasts, and your local station live',
};
const brands = national.map((b) => {
  const by = Object.fromEntries(b.apps.map((a) => [a.platform, a.url]));
  return { ...b, web: by.web, ios: by.ios ?? '', android: by.android ?? '' };
});
---
<section class="panel" aria-labelledby="national-heading">
  <div class="stack gap-4">
    <h2 id="national-heading" class="h3">National apps</h2>
  </div>
  {brands.map((b) => (
    <div class="panel-row">
      <p class="body-strong">{b.name}</p>
      <p class="small muted">{DESCRIPTIONS[b.id] ?? b.description}</p>
      <a class="btn btn-secondary" href={b.web} data-national data-ios={b.ios} data-android={b.android} rel="noopener">
        <Icon name="phone" />
        <span>Get the {b.name} app</span>
      </a>
    </div>
  ))}
</section>
