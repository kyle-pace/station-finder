---
// Brand mark: a play button inside a map pin ("watch, near you"). Abstract on purpose: no
// PBS/NPR imagery.
interface Props { size?: number; class?: string }
const { size = 28, class: className } = Astro.props;
---
<svg class={className} width={size} height={size} viewBox="0 0 40 40" fill="none" aria-hidden="true">
  <path d="M20 37s-13-11-13-21a13 13 0 0 1 26 0c0 10-13 21-13 21z" fill="var(--accent)" />
  <path d="M16.5 10.5v11l9-5.5z" fill="var(--on-accent)" />
</svg>
