---
// Brand mark: a dot sending out broadcast waves. Abstract on purpose: no PBS/NPR imagery.
interface Props { size?: number; class?: string }
const { size = 28, class: className } = Astro.props;
---
<svg class={className} width={size} height={size} viewBox="0 0 32 32" fill="none" aria-hidden="true">
  <circle cx="9" cy="23" r="4.5" fill="var(--warm)" />
  <path d="M9 12.5A10.5 10.5 0 0 1 19.5 23" stroke="var(--accent)" stroke-width="3.4" stroke-linecap="round" />
  <path d="M9 4.5A18.5 18.5 0 0 1 27.5 23" stroke="var(--accent)" stroke-width="3.4" stroke-linecap="round" opacity="0.55" />
</svg>
