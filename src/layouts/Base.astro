---
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { url, SITE_NAME, correctionUrl } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean; // keep a page out of search results (e.g. /go/ redirect pages)
  appleAppId?: string; // station's iPhone app: Safari shows Apple's "Get the app" banner
  manifest?: string; // station's manifest naming its Android app (Chrome's "Get the app")
}

const {
  title,
  description = 'Find your local public media station and every way to watch and listen.',
  noindex = false,
  appleAppId,
  manifest,
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const here = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {appleAppId && <meta name="apple-itunes-app" content={`app-id=${appleAppId}`} />}
    {manifest && <link rel="manifest" href={manifest} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1118" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="wordmark" href={url('/')} aria-label={`${SITE_NAME} home`}>
          <Logo />
          <span>Station App Finder</span>
        </a>
        <nav aria-label="Site">
          <a class="label" href={url('/state/')} aria-current={here.includes('/state/') ? 'page' : undefined}><span class="wide">Browse by state</span><span class="narrow-only">States</span></a>
          <a class="label" href={url('/about/')} aria-current={here.includes('/about/') ? 'page' : undefined}>About</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="stack gap-12 footer-brand">
          <a class="wordmark" href={url('/')}><Logo size={24} /><span>Station App Finder</span></a>
          <p class="caption muted">
            An independent prototype. Not affiliated with or endorsed by PBS or NPR. No cookies, no tracking.
          </p>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a class="label" href={url('/state/')}>Browse by state</a>
          <a class="label" href={url('/help/')}>How to get the apps</a>
          <a class="label" href={url('/about/')}>About</a>
          <a class="label" href={url('/about/#sources')}>Data sources</a>
          <a class="label" href={url('/about/#privacy')}>Privacy</a>
          <a class="label" href={correctionUrl()}>Suggest a correction</a>
        </nav>
        <p class="caption muted attribution">
          Station information drawn in part from Wikipedia's{' '}
          <a href="https://en.wikipedia.org/wiki/List_of_PBS_member_stations">List of PBS member stations</a>,{' '}
          <a href="https://en.wikipedia.org/wiki/List_of_NPR_stations">List of NPR stations</a>,{' '}
          and station articles (Wikipedia contributors), used under{' '}
          <a href="https://creativecommons.org/licenses/by-sa/4.0/">CC BY-SA 4.0</a>, and from public
          U.S. Census data and stations' own websites.
        </p>
      </div>
    </footer>
    <script src="../scripts/device.ts"></script>
  </body>
</html>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.6) blur(14px); -webkit-backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
  }
  .header-inner { display: flex; align-items: center; justify-content: space-between; min-height: 64px; gap: var(--space-16); }
  .wordmark { display: inline-flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none; font-weight: 800; font-size: 18px; letter-spacing: -0.02em; }
  nav { display: flex; gap: var(--space-4); }
  nav a { text-decoration: none; color: var(--text); padding: var(--space-8) var(--space-12); border-radius: var(--radius-full); transition: background-color 0.15s; }
  nav a:hover { background: var(--surface); }
  nav a[aria-current='page'] { background: var(--accent-subtle); color: var(--accent); }
  .narrow-only { display: none; }
  @media (max-width: 600px) { .wide { display: none; } .narrow-only { display: inline; } .wordmark span { font-size: 17px; } }

  .site-footer { background: var(--surface); border-top: 1px solid var(--border); padding: var(--space-48) 0 var(--space-32); }
  .footer-inner { display: grid; gap: var(--space-24); }
  @media (min-width: 801px) { .footer-inner { grid-template-columns: 1.2fr 1fr; } .attribution { grid-column: 1 / -1; } }
  .footer-brand { max-width: 420px; }
  .footer-links { display: flex; flex-wrap: wrap; gap: var(--space-4) var(--space-8); align-content: flex-start; margin-left: calc(-1 * var(--space-12)); }
  .footer-links a { color: var(--text); }
  .attribution { border-top: 1px solid var(--border); padding-top: var(--space-16); }
</style>
