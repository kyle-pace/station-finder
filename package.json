{
  "name": "station-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A neutral directory for finding your local public media station and every way to watch and listen.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run build-data && astro check && astro build",
    "preview": "astro preview",
    "build-data": "node scripts/build-data.ts",
    "build-zcta": "node scripts/build-zcta.ts",
    "fetch-wikipedia": "node scripts/fetch-wikipedia.ts",
    "fetch-wikipedia-npr": "node scripts/fetch-wikipedia-npr.ts",
    "fetch-station-app-pages": "node scripts/fetch-station-app-pages.ts",
    "refresh-data": "npm run fetch-wikipedia && npm run fetch-wikipedia-npr && npm run build-data && npm run fetch-station-app-pages && npm run fetch-wikipedia-places && npm run build-data",
    "fetch-wikipedia-places": "node scripts/fetch-wikipedia-places.ts"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "astro": "^7.4.0",
    "qrcode": "^1.5.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/topojson-client": "^3.1.5",
    "cheerio": "^1.2.0",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.3",
    "us-atlas": "^3.0.1"
  }
}
